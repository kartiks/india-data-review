---
// One row per year on a shared value axis: ranges, points and rings, optionally joined by a thin line.
// Used for "how the estimate moved" (revisions) and "forecast vs outcome". Hover/tap/focus a row for its values;
// every value is also in the table view.
import { SIZES, niceTicks, scale } from "../lib/chart";

export type Shape = "range" | "dot" | "ring" | "small" | "diamond";
export interface RowSeries { name: string; slot: number; shape: Shape; join?: boolean }
export interface Mark { s: number; v?: number; lo?: number; hi?: number; text?: string }
export interface Row { label: string; marks: Mark[]; note?: string }
interface Props {
  title: string;
  subtitle?: string;
  series: RowSeries[];
  rows: Row[];
  format: (v: number) => string;
  source?: string;
  zero?: boolean;
  tableNotes?: boolean;
}
const { title, subtitle, series, rows, format, source, zero = true, tableNotes = false } = Astro.props;

const values = rows.flatMap((r) => r.marks.flatMap((m) => [m.v, m.lo, m.hi])).filter((v): v is number => v != null);
let lo = Math.min(...values), hi = Math.max(...values);
if (zero) { lo = Math.min(0, lo); hi = Math.max(0, hi); }
const ticks = niceTicks(lo, hi, 5);
const id = "r" + Math.random().toString(36).slice(2, 9);
const markText = (m: Mark) => m.text ?? (m.v != null ? format(m.v) : m.lo != null && m.hi != null ? (m.lo === m.hi ? format(m.lo) : `${format(m.lo)} to ${format(m.hi)}`) : "–");

const charts = SIZES.map((sz) => {
  const rowH = sz.name === "sm" ? 22 : 24;
  const labelW = sz.name === "sm" ? 50 : 62;
  const top = 8, bottom = 22, right = 14;
  const height = top + rows.length * rowH + bottom;
  const x = scale(ticks[0], ticks[ticks.length - 1], labelW + 6, sz.width - right);
  const yMid = (i: number) => top + i * rowH + rowH / 2;
  return { sz, rowH, labelW, top, bottom, right, height, x, yMid };
});

const tipData = JSON.stringify({
  columns: rows.map((r) => ({
    title: r.label,
    rows: r.marks.map((m) => ({ slot: series[m.s].slot, value: markText(m), name: series[m.s].name })),
  })),
});
const diamond = (cx: number, cy: number, s = 5.5) => `M${cx},${cy - s}L${cx + s},${cy}L${cx},${cy + s}L${cx - s},${cy}Z`;
---
<figure class="chart range-rows" id={id}>
  <figcaption>
    <h3>{title}</h3>
    {subtitle && <p class="muted small">{subtitle}</p>}
  </figcaption>
  <ul class="legend small" aria-label="Legend">
    {series.map((s) => (
      <li>
        <svg width="18" height="12" aria-hidden="true">
          {s.shape === "range" && <rect x="1" y="2" width="16" height="8" rx="4" fill={`var(--s${s.slot})`} fill-opacity="0.35" stroke={`var(--s${s.slot})`} stroke-width="1.5" />}
          {s.shape === "dot" && <circle cx="9" cy="6" r="4.5" fill={`var(--s${s.slot})`} />}
          {s.shape === "ring" && <circle cx="9" cy="6" r="4" fill="var(--surface)" stroke={`var(--s${s.slot})`} stroke-width="2" />}
          {s.shape === "small" && <circle cx="9" cy="6" r="2.5" fill={`var(--s${s.slot})`} />}
          {s.shape === "diamond" && <path d={diamond(9, 6, 5)} fill={`var(--s${s.slot})`} />}
        </svg>
        {s.name}
      </li>
    ))}
  </ul>
  {charts.map(({ sz, rowH, labelW, top, bottom, height, x, yMid }) => (
    <svg class={`plot plot-${sz.name}`} viewBox={`0 0 ${sz.width} ${height}`} role="img"
      aria-label={`${title}. Values are listed in the table below.`} style={`font-size:${sz.font}px`}>
      {ticks.map((t) => (
        <g>
          <line x1={x(t)} x2={x(t)} y1={top} y2={height - bottom} class={t === 0 ? "baseline" : "gridline"} />
          <text x={x(t)} y={height - 6} text-anchor="middle" class="tick">{format(t)}</text>
        </g>
      ))}
      {rows.map((r, i) => {
        const pts = r.marks.filter((m) => m.v != null && series[m.s].join).map((m) => m.v!);
        const y = yMid(i);
        return (
          <g data-col={i} tabindex="0" class="row" aria-label={`${r.label}: ${r.marks.map((m) => `${series[m.s].name} ${markText(m)}`).join(", ")}`}>
            <rect x="0" y={top + i * rowH} width={sz.width} height={rowH} class="row-hit" />
            <text x={labelW} y={y} dy="0.32em" text-anchor="end" class="tick row-label">{r.label}</text>
            {pts.length > 1 && <line x1={x(Math.min(...pts))} x2={x(Math.max(...pts))} y1={y} y2={y} class="join" />}
            {r.marks.filter((m) => series[m.s].shape === "range" && m.lo != null && m.hi != null).map((m) => {
              const x0 = x(m.lo!), x1 = Math.max(x(m.hi!), x0 + 4);
              return <rect x={x0 - 2} y={y - 5} width={x1 - x0 + 4} height="10" rx="5" fill={`var(--s${series[m.s].slot})`} fill-opacity="0.35" stroke={`var(--s${series[m.s].slot})`} stroke-width="1.5" />;
            })}
            {r.marks.filter((m) => m.v != null && series[m.s].shape !== "range").map((m) => {
              const s = series[m.s], cx = x(m.v!);
              if (s.shape === "small") return <circle cx={cx} cy={y} r="2.5" fill={`var(--s${s.slot})`} />;
              if (s.shape === "ring") return <circle cx={cx} cy={y} r="4.5" fill="var(--surface)" stroke={`var(--s${s.slot})`} stroke-width="2" />;
              if (s.shape === "diamond") return <path d={diamond(cx, y)} fill={`var(--s${s.slot})`} stroke="var(--surface)" stroke-width="1.5" />;
              return <circle cx={cx} cy={y} r="4.5" fill={`var(--s${s.slot})`} stroke="var(--surface)" stroke-width="2" />;
            })}
          </g>
        );
      })}
    </svg>
  ))}
  <script type="application/json" class="chart-data" set:html={tipData} />
  <details class="table-view">
    <summary>Show as table</summary>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Year</th>{series.map((s) => <th>{s.name}</th>)}{tableNotes && <th>Note</th>}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.label}</td>
              {series.map((_, j) => {
                const ms = r.marks.filter((m) => m.s === j);
                return <td>{ms.length ? ms.map(markText).join(", ") : "–"}</td>;
              })}
              {tableNotes && <td class="wrap-text">{r.note ?? ""}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  {source && <p class="source">{source}</p>}
</figure>

<style>
  .chart { margin: 0; }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 14px; padding: 0; margin: 6px 0 4px; color: var(--ink-2); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .plot { width: 100%; height: auto; display: block; touch-action: pan-y; }
  .plot-lg { display: none; }
  @media (min-width: 640px) { .plot-sm { display: none; } .plot-lg { display: block; } }
  .plot :global(.gridline) { stroke: var(--grid); stroke-width: 1; }
  .plot :global(.baseline) { stroke: var(--axis); stroke-width: 1.5; }
  .plot :global(.tick) { fill: var(--muted); }
  .plot :global(.row-label) { fill: var(--ink-2); }
  .plot :global(.join) { stroke: var(--axis); stroke-width: 2; stroke-linecap: round; }
  .row { cursor: pointer; outline: none; }
  .row-hit { fill: transparent; }
  .row:global(.active) .row-hit, .row:focus .row-hit { fill: var(--surface-2); }
</style>
