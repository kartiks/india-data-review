---
// One row per item (e.g. a state) with two or more dots on a shared scale, joined by a thin line:
// rural vs urban, women vs men. Plain HTML so long names wrap on phones; every value is printed,
// so no hover is needed. A table view lists the same numbers.
export interface DotSeries { name: string; slot: number }
export interface DotRow { label: string; values: (number | null)[]; note?: string; strong?: boolean }
interface Props {
  title?: string;
  subtitle?: string;
  series: DotSeries[];
  rows: DotRow[];
  format: (v: number) => string;
  source?: string;
  zero?: boolean; // start the scale at zero (default true)
}
const { title, subtitle, series, rows, format, source, zero = true } = Astro.props;
const all = rows.flatMap((r) => r.values).filter((v): v is number => v != null);
const lo = zero ? Math.min(0, ...all) : Math.min(...all);
const hi = Math.max(...all);
const pad = (hi - lo) * 0.04 || 1;
const x0 = zero && lo >= 0 ? lo : lo - pad;
const x1 = hi + pad;
const pos = (v: number) => ((v - x0) / (x1 - x0)) * 100;
---
<figure class="chart dot-rows">
  {(title || subtitle) && (
    <figcaption>
      {title && <h3>{title}</h3>}
      {subtitle && <p class="muted small">{subtitle}</p>}
    </figcaption>
  )}
  {series.length > 1 && <ul class="legend small" aria-label="Legend">
    {series.map((s) => (
      <li><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill={`var(--s${s.slot})`} /></svg>{s.name}</li>
    ))}
  </ul>}
  <ol class="rows" aria-label={title || subtitle || "Values"}>
    {rows.map((r) => {
      const vs = r.values.map((v, i) => ({ v, i })).filter((d): d is { v: number; i: number } => d.v != null);
      const a = Math.min(...vs.map((d) => d.v)), b = Math.max(...vs.map((d) => d.v));
      return (
        <li class={r.strong ? "strong" : undefined}>
          <div class="line">
            <span class="name">{r.label}</span>
            <span class="vals">
              {vs.map((d, k) => (
                <>{k > 0 && <span class="sep"> · </span>}<span class="val"><i style={`background:var(--s${series[d.i].slot})`} aria-hidden="true" /><span class="sr-only">{series[d.i].name}: </span>{format(d.v)}</span></>
              ))}
            </span>
          </div>
          <div class="track" aria-hidden="true">
            {vs.length > 1 && <span class="join" style={`left:${pos(a).toFixed(2)}%;width:${(pos(b) - pos(a)).toFixed(2)}%`} />}
            {vs.map((d) => <span class="dot" style={`left:${pos(d.v).toFixed(2)}%;background:var(--s${series[d.i].slot})`} />)}
          </div>
          {r.note && <p class="row-note small muted">{r.note}</p>}
        </li>
      );
    })}
  </ol>
  <details class="table-view">
    <summary>Show as table</summary>
    <div class="table-scroll">
      <table>
        <thead><tr><th></th>{series.map((s) => <th>{s.name}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><td>{r.label}</td>{r.values.map((v) => <td>{v == null ? "–" : format(v)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  {source && <p class="source">{source}</p>}
</figure>

<style>
  .chart { margin: 0; }
  .chart figcaption h3 { margin-bottom: 2px; }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 14px; padding: 0; margin: 6px 0 4px; color: var(--ink-2); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { padding: 6px 0; }
  .rows li.strong .name { font-weight: 600; }
  .line { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; font-size: 0.9rem; }
  .vals { text-align: right; white-space: nowrap; color: var(--ink); font-variant-numeric: tabular-nums; }
  .val i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; vertical-align: 1px; }
  .sep { color: var(--muted); }
  .track { position: relative; height: 14px; margin: 3px 6px 0; border-bottom: 1px solid var(--grid); }
  .join { position: absolute; top: 6px; height: 2px; background: var(--axis); }
  .dot { position: absolute; top: 2px; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; box-shadow: 0 0 0 2px var(--surface); }
  .row-note { margin: 2px 0 0; }
</style>
