---
// Line chart over fiscal years, drawn at build time.
// Hollow markers = estimates (Budget or Revised); the line itself is the best figure available each year.
import { estimate, estimateLayout } from "../lib/chart";
import { linePlots } from "../lib/line-plot";
import { safeJson } from "../lib/safe-json";
import "../styles/charts.css";
import OrDash from "./OrDash.astro";

export interface Point {
  value: number | null;
  kind?: string; // "Actual" | "RE" | "BE"
  estimate?: boolean;
}
export interface Series {
  name: string;
  slot: number; // categorical slot 1..8
  dashed?: boolean; // a dashed line: a second measure in the same colour, e.g. food prices beside all items
  points: Point[]; // aligned with `years`
}
interface Props {
  title: string;
  subtitle?: string;
  years: string[];
  series: Series[];
  format: (v: number) => string; // axis + tooltip
  tableFormat?: (v: number) => string;
  tipFormat?: (v: number) => string; // hover readout (defaults to tableFormat)
  annotations?: { year: string; label: string }[];
  zero?: boolean; // include zero in the y range (default true)
  source?: string;
  estimateLabel?: string; // legend text for hollow markers
  headingLevel?: 2 | 3; // 2 (default) for a chart card directly under the page's h1; 3 inside a section with an h2
}
const { title, subtitle, years, series, format, tableFormat = format, tipFormat = tableFormat, annotations = [], zero = true, source, estimateLabel = "Estimate (no actual yet)", headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";

const hasEstimates = series.some((s) => s.points.some((p) => p.estimate && p.value != null));
const id = "c" + Math.random().toString(36).slice(2, 9);

// Drawn by lib/line-plot (the same drawing as PickLines), with estimate markers, annotations and, for one series,
// an end label where the size leaves room (with 2+ series: legend and hover instead).
const plots = linePlots(
  years,
  series.map((s) => ({ name: s.name, color: `var(--s${s.slot})`, dashed: s.dashed, values: s.points.map((p) => p.value), estimates: s.points.map((p) => !!p.estimate) })),
  format,
  `${title}. Values are listed in the table below.`,
  { zero, endLabel: true, annotations },
);

// Estimate labels in short form; left out when every figure has the same one (said once, under the chart).
const est = series.map((s) => s.points.map((p) => (p.value == null ? null : estimate(p.kind))));
const layout = estimateLayout(years.map((_, i) => est.map((e) => e[i]?.short ?? null)));
const rowEst = years.map((_, i) => est.map((e) => e[i]).find((e) => e?.short) ?? null); // "column" mode
const allEst = layout.all ? est.flat().find((e) => e?.short === layout.all) : undefined;

const tooltipData = safeJson({
  years,
  series: series.map((s, j) => ({
    name: s.name,
    slot: s.slot,
    values: s.points.map((p, i) => (p.value == null ? null : { t: tipFormat(p.value), k: layout.mode === "none" ? "" : est[j][i]!.short })),
  })),
});
---
<figure class="chart line-chart" id={id}>
  <figcaption>
    <Heading class="chart-title">{title}</Heading>
    {subtitle && <p class="muted small">{subtitle}</p>}
  </figcaption>
  {(series.length > 1 || hasEstimates) && (
    <ul class="legend small" aria-label="Legend">
      {series.length > 1 && series.map((s) => (
        <li><svg width="16" height="10" aria-hidden="true"><line x1="1" y1="5" x2="15" y2="5" stroke={`var(--s${s.slot})`} stroke-width="2" stroke-linecap="round" stroke-dasharray={s.dashed ? "5 4" : undefined} /></svg>{s.name}</li>
      ))}
      {hasEstimates && (
        <li><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="var(--surface)" stroke="var(--ink-2)" stroke-width="2" /></svg>{estimateLabel}</li>
      )}
    </ul>
  )}
  <Fragment set:html={plots} />
  <script type="application/json" class="chart-data" set:html={tooltipData} />
  {allEst && <p class="muted small est-note">All figures: {allEst.full}.</p>}
  <details class="table-view">
    <summary>Show as table</summary>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Year</th>{layout.mode === "column" && <th class="est-col">Estimate</th>}{series.map((s) => <th>{s.name}</th>)}</tr></thead>
        <tbody>
          {years.map((yr, i) => (
            <tr>
              <td>{yr}</td>
              {layout.mode === "column" && <td class="est-col">{rowEst[i] && <span class="est" title={rowEst[i].full}>{rowEst[i].short}</span>}</td>}
              {series.map((s, j) => {
                const p = s.points[i], e = est[j][i];
                return <td>{layout.mode === "inline" && e?.short && <span class="est" title={e.full}>{e.short}</span>}<OrDash v={p.value} fmt={tableFormat} /></td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  {source && <p class="source">{source}</p>}
</figure>

<style>
  .chart { margin: 0; }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 14px; padding: 0; margin: 6px 0 4px; color: var(--ink-2); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .chart :global(.plot) { width: 100%; height: auto; overflow: visible; touch-action: pan-y; }
  .chart :global(.plot .gridline) { stroke: var(--grid); stroke-width: 1; }
  .chart :global(.plot .baseline) { stroke: var(--axis); stroke-width: 1; }
  .chart :global(.plot .tick) { fill: var(--muted); }
  .chart :global(.plot .end-label) { fill: var(--ink-2); font-weight: 600; }
  .chart :global(.plot .annotation line) { stroke: var(--axis); stroke-width: 1; }
  .chart :global(.plot .crosshair) { stroke: var(--ink-2); stroke-width: 1; }
  .est { color: var(--ink-2); font-size: 0.85em; margin-right: 6px; }
  .est-col { text-align: left; }
  .est-col .est { margin-right: 0; }
  .est-note { margin: 4px 0 0; }
</style>
