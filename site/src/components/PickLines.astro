---
// Line chart whose lines the reader chooses (up to `max`, one colour each), plus an optional dashed reference line
// that does not count against the limit. The starting set is drawn at build time, so the chart reads without
// JavaScript; a script redraws it as lines are added or removed, rebuilds the table, and keeps the choice in the
// address (#show=key,key) so a comparison can be shared. Values are formatted at build time; axis ticks use the
// named `axis` format, the same at build time and in the browser.
import { AXIS_FORMATS, assignSlots, linePlots, slotColor, yearsWithData, type AxisFormat } from "../lib/line-plot";
import { safeJson } from "../lib/safe-json";
import "../styles/charts.css";

export interface PickOption {
  key: string;
  name: string;
  values: (number | null)[]; // aligned with `years`
  kinds?: string[]; // per year, e.g. "worked out"; shown after the name in the readout and the table
  note?: string; // shown below the chart while this line is shown
}
interface Props {
  title: string;
  subtitle?: string;
  years: string[];
  options: PickOption[];
  reference?: PickOption;
  initial: string[];
  max?: number;
  noun?: string; // "state"
  axis: AxisFormat;
  tipFormat: (v: number) => string;
  source?: string;
  headingLevel?: 2 | 3; // 2 (default) for a chart card directly under the page's h1; 3 inside a section with an h2
}
const { title, subtitle, years, options, reference, initial, max = 8, noun = "state", axis, tipFormat, source, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";

const pack = (o: PickOption) => ({
  key: o.key, name: o.name, note: o.note ?? "",
  v: o.values,
  t: o.values.map((v) => (v == null ? null : tipFormat(v))),
  k: o.kinds ?? o.values.map(() => ""),
});
const opts = options.map(pack);
const ref = reference ? pack(reference) : null;
const all = [...(ref ? [ref] : []), ...opts];
const byKey = new Map(all.map((o) => [o.key, o]));

// Build-time drawing of the starting set, the same way the script draws any set.
const start = assignSlots(initial, (k) => byKey.has(k), ref?.key, max).map((c) => ({ ...c, o: byKey.get(c.key)! }));
const shown = yearsWithData(years, start.map(({ o }) => ({ values: o.v })));
const label = `${title}. Values are listed in the table below.`;
const plots = linePlots(shown, start.map(({ o, slot }) => ({
  name: o.name, color: slotColor(slot), dashed: slot === 0, values: o.v.slice(0, shown.length),
})), AXIS_FORMATS[axis], label);
const payload = safeJson({ years, options: opts, reference: ref, initial, max, axis, label });
const inStart = new Set(start.map((c) => c.key));
---
<figure class="chart pick-lines">
  <figcaption>
    <Heading class="chart-title">{title}</Heading>
    {subtitle && <p class="muted small">{subtitle}</p>}
  </figcaption>
  <ul class="chips small" aria-label={`${noun[0].toUpperCase()}${noun.slice(1)}s shown`}>
    {start.map(({ o, slot }) => (
      <li><span class="chip static"><span class={slot === 0 ? "sw dashed" : "sw"} style={slot === 0 ? undefined : `background:${slotColor(slot)}`} aria-hidden="true" />{o.name}</span></li>
    ))}
  </ul>
  <details class="choose" hidden>
    <summary>Choose {noun}s</summary>
    <div class="choose-panel">
      <div class="choose-bar small">
        <button type="button" class="reset">Reset</button>
        <button type="button" class="clear">Clear</button>
        <span class="limit muted" role="status"></span>
      </div>
      <fieldset class="small">
        <legend class="sr-only">{noun[0].toUpperCase()}{noun.slice(1)}s to show, up to {max}{ref ? `, plus ${ref.name}` : ""}</legend>
        {all.map((o) => (
          <label><input type="checkbox" value={o.key} checked={inStart.has(o.key)} />{o.name}</label>
        ))}
      </fieldset>
    </div>
  </details>
  <div class="plots" set:html={plots} />
  <p class="empty muted small" hidden>Choose a {noun} to draw its line.</p>
  <ul class="pick-notes small muted">
    {[...new Set(start.map(({ o }) => o.note).filter(Boolean))].map((n) => <li>{n}</li>)}
  </ul>
  <details class="table-view">
    <summary>Show as table</summary>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Year</th>{start.map(({ o }) => <th>{o.name}</th>)}</tr></thead>
        <tbody>
          {shown.map((yr, i) => (
            <tr><td>{yr}</td>{start.map(({ o }) => <td>{o.t[i] ?? "–"}{o.t[i] && o.k[i] ? ` (${o.k[i]})` : ""}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  {source && <p class="source">{source}</p>}
  <script type="application/json" class="pick-data" set:html={payload} />
</figure>

<script>
  import { AXIS_FORMATS, assignSlots, linePlots, slotColor, yearsWithData, type AxisFormat } from "../lib/line-plot";
  import { setupLine } from "../scripts/charts";

  interface Opt { key: string; name: string; note: string; v: (number | null)[]; t: (string | null)[]; k: string[] }
  interface Data { years: string[]; options: Opt[]; reference: Opt | null; initial: string[]; max: number; axis: AxisFormat; label: string }

  function setup(fig: HTMLElement) {
    const data = JSON.parse(fig.querySelector(".pick-data")!.textContent!) as Data;
    const ref = data.reference;
    const byKey = new Map([...data.options, ...(ref ? [ref] : [])].map((o) => [o.key, o]));
    const pick = (keys: string[], current: { key: string; slot: number }[] = []) =>
      assignSlots(keys, (k) => byKey.has(k), ref?.key, data.max, current);
    let chosen: { key: string; slot: number }[] = [];

    const chips = fig.querySelector<HTMLUListElement>(".chips")!;
    const boxes = [...fig.querySelectorAll<HTMLInputElement>(".choose input[type=checkbox]")];
    const summary = fig.querySelector<HTMLElement>(".choose summary")!;
    const plots = fig.querySelector<HTMLDivElement>(".plots")!;
    const notes = fig.querySelector<HTMLUListElement>(".pick-notes")!;
    const table = fig.querySelector<HTMLTableElement>(".table-view table")!;
    const limit = fig.querySelector<HTMLElement>(".limit")!;
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string) => {
      const e = document.createElement(tag);
      if (text != null) e.textContent = text;
      return e;
    };

    /** Redraw everything from `chosen`. `focusKey`: after a chip is removed, the chip to move focus to ("" = none
     *  left, so focus goes to the Choose button). */
    const render = (focusKey?: string) => {
      const sel = chosen.map((c) => ({ c, o: byKey.get(c.key)! }));
      const years = yearsWithData(data.years, sel.map(({ o }) => ({ values: o.v })));

      // Chart (hidden when nothing is chosen, rather than an empty axis)
      plots.innerHTML = sel.length ? linePlots(years, sel.map(({ c, o }) => ({
        name: o.name, color: slotColor(c.slot), dashed: c.slot === 0, values: o.v.slice(0, years.length),
      })), AXIS_FORMATS[data.axis], data.label) : "";
      setupLine(fig, {
        years,
        series: sel.map(({ c, o }) => ({
          name: o.name, slot: c.slot, color: slotColor(c.slot),
          values: years.map((_, i) => (o.t[i] == null ? null : { t: o.t[i]!, k: o.k[i] })),
        })),
      });
      fig.querySelector<HTMLElement>(".empty")!.hidden = sel.length > 0;
      fig.querySelector<HTMLElement>(".table-view")!.hidden = sel.length === 0;

      // Chips (also the legend)
      chips.replaceChildren(...sel.map(({ c, o }) => {
        const li = el("li");
        const b = el("button");
        b.type = "button";
        b.className = "chip";
        b.dataset.key = o.key;
        b.setAttribute("aria-label", `Remove ${o.name}`);
        const sw = el("span");
        sw.className = c.slot === 0 ? "sw dashed" : "sw";
        if (c.slot !== 0) sw.style.background = slotColor(c.slot);
        sw.setAttribute("aria-hidden", "true");
        const x = el("span", "×");
        x.className = "x";
        x.setAttribute("aria-hidden", "true");
        b.append(sw, o.name, x);
        li.append(b);
        return li;
      }));
      if (focusKey != null) (chips.querySelector<HTMLButtonElement>(`[data-key="${focusKey}"]`) ?? summary).focus();

      // Checkboxes: ticked for lines shown; the rest disabled at the limit (the reference line never is).
      const full = chosen.filter((c) => c.key !== ref?.key).length >= data.max;
      for (const b of boxes) {
        b.checked = chosen.some((c) => c.key === b.value);
        b.disabled = full && !b.checked && b.value !== ref?.key;
      }
      limit.textContent = full ? `Up to ${data.max} at once: untick one to add another.` : "";

      // Notes for the lines shown
      notes.replaceChildren(...[...new Set(sel.map(({ o }) => o.note).filter(Boolean))].map((n) => el("li", n)));

      // Table
      const head = el("tr");
      head.append(el("th", "Year"), ...sel.map(({ o }) => el("th", o.name)));
      const body = years.map((yr, i) => {
        const tr = el("tr");
        tr.append(el("td", yr), ...sel.map(({ o }) => el("td", o.t[i] == null ? "–" : `${o.t[i]}${o.k[i] ? ` (${o.k[i]})` : ""}`)));
        return tr;
      });
      table.tHead!.replaceChildren(head);
      table.tBodies[0].replaceChildren(...body);

      // Address: #show=… when the choice differs from the starting set; otherwise drop only our own hash.
      const keys = chosen.map((c) => c.key);
      const same = keys.length === data.initial.length && keys.every((k, i) => k === data.initial[i]);
      if (!same) history.replaceState(null, "", `#show=${keys.join(",")}`);
      else if (location.hash.startsWith("#show")) history.replaceState(null, "", location.pathname + location.search);
    };

    // No "#show" = the starting set; an empty "#show=" = an empty chart; a list naming nothing we know = the
    // starting set.
    const fromAddress = () => {
      const keys = location.hash.startsWith("#show") ? new URLSearchParams(location.hash.slice(1)).get("show") : null;
      chosen = pick(keys != null ? keys.split(",") : data.initial);
      if (!chosen.length && keys) chosen = pick(data.initial);
      render();
    };
    fromAddress();
    // Going back to the page's own address restores the starting set; other in-page links leave the choice alone.
    window.addEventListener("hashchange", () => { if (location.hash === "" || location.hash.startsWith("#show")) fromAddress(); });
    fig.querySelector<HTMLElement>(".choose")!.hidden = false;

    chips.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button.chip");
      const i = chosen.findIndex((c) => c.key === b?.dataset.key);
      if (i < 0) return;
      chosen.splice(i, 1);
      render(chosen[i]?.key ?? chosen[i - 1]?.key ?? "");
    });
    for (const b of boxes) {
      b.addEventListener("change", () => {
        chosen = b.checked ? pick([b.value], chosen) : chosen.filter((c) => c.key !== b.value);
        render();
      });
    }
    fig.querySelector(".reset")!.addEventListener("click", () => { chosen = pick(data.initial); render(); });
    fig.querySelector(".clear")!.addEventListener("click", () => { chosen = []; render(); });
  }
  document.querySelectorAll<HTMLElement>("figure.pick-lines").forEach(setup);
</script>

<style>
  .chart { margin: 0; }
  .chart figcaption .chart-title { font-size: 1.05rem; margin-bottom: 2px; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 8px 0; }
  /* Chips are rebuilt by the script, so their styles are global within the list. */
  .chips :global(.chip) { font: inherit; display: inline-flex; align-items: center; gap: 6px; padding: 4px 8px 4px 10px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--ink); cursor: pointer; }
  .chips :global(.chip:hover) { border-color: var(--ink-2); }
  .chips .chip.static, .chips .chip.static:hover { cursor: default; border-color: var(--border); }
  .chips :global(.sw) { width: 14px; height: 3px; border-radius: 2px; flex: none; }
  .chips :global(.sw.dashed) { background: repeating-linear-gradient(90deg, var(--ink-2) 0 5px, transparent 5px 8px); }
  .chips :global(.x) { color: var(--muted); font-size: 1.1em; line-height: 1; }
  .choose { margin: 0 0 8px; }
  .choose[hidden], .empty[hidden], .table-view[hidden] { display: none; }
  .choose summary { cursor: pointer; font-weight: 600; font-size: 0.9rem; }
  .choose-panel { margin-top: 8px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; }
  .choose-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin-bottom: 8px; }
  .reset, .clear { font: inherit; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--ink-2); cursor: pointer; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5em, 1fr)); gap: 4px 12px; }
  fieldset label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
  fieldset label:has(input:disabled) { color: var(--muted); cursor: default; }
  .empty { margin: 4px 0 0; }
  .pick-notes { padding-left: 18px; margin: 8px 0 0; }
  .pick-notes:empty { display: none; }
  .plots :global(.plot) { width: 100%; height: auto; overflow: visible; touch-action: pan-y; }
  .plots :global(.gridline) { stroke: var(--grid); stroke-width: 1; }
  .plots :global(.baseline) { stroke: var(--axis); stroke-width: 1; }
  .plots :global(.tick) { fill: var(--muted); }
  .plots :global(.crosshair) { stroke: var(--ink-2); stroke-width: 1; }
</style>
