---
import { link } from "../../lib/url";
// "Source: ..." line linking to the official document the figures were read from.
import { type Kind, KIND_LABEL, headline } from "../../lib/budget/data";
import { nextFy } from "../../lib/fy";

// `url`: the document to link to; by default the budget's Budget at a Glance; null for none.
interface Props { year: string; kind: Kind; docs: string[]; url?: string | null }
const { year, kind, docs } = Astro.props;
const budget = kind === "be" ? year : kind === "re" ? nextFy(year) : nextFy(nextFy(year));
const url = Astro.props.url === undefined ? headline(year, "total_expenditure", kind)?.source.url : Astro.props.url;
---
<p class="source">
  Source: {docs.join("; ")}, Budget {budget} ({KIND_LABEL[kind]}s for {year}).{" "}
  {url && <><a href={url} rel="external noopener">Official PDF</a>{" · "}</>}
  <a href={link("/budget/sources/")}>Sources and checks</a>
</p>
