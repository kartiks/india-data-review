---
import { link } from "../lib/url";
import { AREAS } from "../lib/area-data";
import "../styles/global.css";
import InlineScript from "../components/InlineScript.astro";
import themeJs from "../scripts/inline/theme.js?raw";
import navEdgesJs from "../scripts/inline/nav-edges.js?raw";
import vercelAnalyticsJs from "../scripts/inline/vercel-analytics.js?raw";
import { LATEST_YEAR as BUDGET_YEAR } from "../lib/budget/data";
import { LATEST_YEAR as GDP_YEAR } from "../lib/gdp/data";

interface Props {
  title: string;
  description?: string;
  section?: string; // sub-tab within the area, e.g. "taxes", "revisions", "about" (= that area's Sources)
}
const SITE = "India Data Review";
const { title, description = "India's economy and public finances from official data, checked: the Union Budget since 2000-01, GDP from MoSPI's national accounts, and jobs, prices and household spending.", section } = Astro.props;

// The section comes from the URL: /<area>/... (src/data/areas.json), /about/, or the home page.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname.slice(base.length) || "/";
const tabs = [
  { id: "home", href: "/", label: "Home" },
  ...AREAS.map((a) => ({ id: a.id, href: `/${a.id}/`, label: a.label })),
  { id: "about", href: "/about/", label: "About" },
];
const area = tabs.find((t) => t.id !== "home" && pathname.startsWith(t.href))?.id ?? (pathname === "/" ? "home" : "");
const subnav: Record<string, { id: string; href: string; label: string }[]> = {
  budget: [
    { id: "overview", href: "/budget/", label: "Overview" },
    { id: "trends", href: "/budget/trends/", label: "Trends" },
    { id: "taxes", href: "/budget/taxes/", label: "Taxes" },
    { id: "ministries", href: "/budget/ministries/", label: "Ministries" },
    { id: "schemes", href: "/budget/schemes/", label: "Schemes" },
    { id: "about", href: "/budget/sources/", label: "Sources" },
  ],
  gdp: [
    { id: "overview", href: "/gdp/", label: "Overview" },
    { id: "growth", href: "/gdp/growth/", label: "Growth" },
    { id: "per-person", href: "/gdp/per-person/", label: "Per person" },
    { id: "revisions", href: "/gdp/revisions/", label: "Revisions" },
    { id: "forecasts", href: "/gdp/forecasts/", label: "Forecasts" },
    { id: "sectors", href: "/gdp/sectors/", label: "Sectors" },
    { id: "states", href: "/gdp/states/", label: "States" },
    { id: "spending", href: "/gdp/spending/", label: "Spending" },
    { id: "quarters", href: "/gdp/quarters/", label: "Quarters" },
    { id: "about", href: "/gdp/sources/", label: "Sources" },
  ],
  "jobs-prices": [
    { id: "overview", href: "/jobs-prices/", label: "Overview" },
    { id: "jobs", href: "/jobs-prices/jobs/", label: "Jobs" },
    { id: "work", href: "/jobs-prices/work/", label: "Work & earnings" },
    { id: "prices", href: "/jobs-prices/prices/", label: "Prices" },
    { id: "spending", href: "/jobs-prices/spending/", label: "Household spending" },
    { id: "states", href: "/jobs-prices/states/", label: "States" },
    { id: "about", href: "/jobs-prices/sources/", label: "Sources" },
  ],
};
const AREA_LABEL: Record<string, string> = Object.fromEntries(AREAS.map((a) => [a.id, a.label]));
const sub = subnav[area];
// "Prices · Jobs & prices · India Data Review"; an area's own overview page is just "GDP · India Data Review".
const fullTitle = title === SITE ? title : `${title} · ${AREA_LABEL[area] && AREA_LABEL[area] !== title ? `${AREA_LABEL[area]} · ` : ""}${SITE}`;
// Vercel Web Analytics (cookieless page-view counts). Only in builds made on Vercel, where the
// /_vercel/insights script exists; local and other builds leave it out.
const analytics = import.meta.env.PROD && process.env.VERCEL === "1";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={link("/favicon.svg")} type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary" />
    {analytics && (
      <>
        <InlineScript code={vercelAnalyticsJs} />
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </>
    )}
    <InlineScript code={themeJs} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={link("/")}>{SITE}</a>
        <button class="theme" type="button" aria-label="Switch light or dark theme" title="Light / dark">◐</button>
      </div>
      <nav class="wrap tabs" aria-label="Sections">
        <ul>
          {tabs.map((t) => (
            <li><a href={link(t.href)} aria-current={area === t.id ? (sub ? "true" : "page") : undefined}>{t.label}</a></li>
          ))}
        </ul>
      </nav>
      {sub && (
        <nav class="subnav" aria-label={`${AREA_LABEL[area]} pages`}>
          <ul class="wrap">
            {sub.map((n) => (
              <li><a href={link(n.href)} aria-current={section === n.id ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
      <InlineScript code={navEdgesJs} />
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap small">
        {area === "budget" && (
          <p>
            Budget figures come from the Government of India's budget documents (indiabudget.gov.in), from Budget
            2000-01 to Budget {BUDGET_YEAR}, and are checked automatically: accounting rules, agreement between
            documents and with RBI and PRS figures. <a href={link("/budget/sources/")}>Sources and checks</a>.
          </p>
        )}
        {area === "gdp" && (
          <p>
            National accounts come from the Ministry of Statistics and Programme Implementation (MoSPI), up to its
            {" "}{GDP_YEAR} estimates; forecasts from the Economic Survey, the Reserve Bank of India and the Union
            Budget. Every figure is checked automatically. <a href={link("/gdp/sources/")}>Sources and checks</a>.
          </p>
        )}
        {area === "jobs-prices" && (
          <p>
            Jobs, prices and household spending come mostly from the Ministry of Statistics and Programme
            Implementation (MoSPI): the Periodic Labour Force Survey, the Consumer Price Index (its data service and
            press releases) and the Household Consumption Expenditure Survey; prices for farm and rural labourers from
            the Labour Bureau, and state comparisons from the Reserve Bank of India. Every figure is checked automatically. <a href={link("/jobs-prices/sources/")}>Sources and checks</a>.
          </p>
        )}
        {!AREA_LABEL[area] && (
          <p>
            Every figure comes from official sources (Union Budget documents, MoSPI's national accounts and surveys of
            jobs, prices and household spending, the Economic Survey and the RBI) and is checked automatically. <a href={link("/about/")}>About this site</a>.
          </p>
        )}
        <p class="muted">
          ₹1 lakh crore = ₹1,00,000 crore ≈ ₹1 trillion. BE = Budget Estimate, RE = Revised Estimate. Real = after
          inflation (constant prices); nominal = in today's rupees (current prices).
        </p>
        <p class="muted">Visits are counted with Vercel Web Analytics: no cookies, no personal data.</p>
      </div>
    </footer>
    <div class="tooltip" role="status" aria-live="polite" hidden></div>
    <script>
      import "../scripts/charts";
      const btn = document.querySelector<HTMLButtonElement>("button.theme");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try { localStorage.setItem("theme", root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; padding-top: 10px; }
  .brand { font-weight: 700; color: var(--ink); text-decoration: none; font-size: 1.05rem; }
  .theme { background: none; border: 1px solid var(--border); color: var(--ink-2); border-radius: 8px; width: 34px; height: 34px; font-size: 1rem; cursor: pointer; }
  nav ul { list-style: none; display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; }
  nav ul::-webkit-scrollbar { display: none; }
  /* Fade an edge when more items are scrolled out of view that way (set by scripts/inline/nav-edges.js). The mask
     only uses alpha, so it works on any background in either theme. */
  nav ul {
    --fade-l: 0px; --fade-r: 0px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--fade-l), #000 calc(100% - var(--fade-r)), transparent);
    mask-image: linear-gradient(to right, transparent, #000 var(--fade-l), #000 calc(100% - var(--fade-r)), transparent);
  }
  nav ul[data-more-left] { --fade-l: 32px; }
  nav ul[data-more-right] { --fade-r: 32px; }
  .tabs ul { margin: 0 -7px; padding: 4px 0 0; }
  .tabs a { display: block; padding: 8px 9px 10px; color: var(--ink-2); text-decoration: none; font-size: 0.95rem; white-space: nowrap; border-bottom: 2px solid transparent; }
  .tabs a[aria-current] { color: var(--ink); border-bottom-color: var(--accent); font-weight: 600; }
  .tabs a:hover { color: var(--ink); }
  .subnav { background: var(--surface-2); border-top: 1px solid var(--border); }
  .subnav ul { padding-top: 2px; padding-bottom: 2px; }
  .subnav li:first-child a { margin-left: -9px; }
  .subnav a { display: block; padding: 6px 9px; color: var(--ink-2); text-decoration: none; font-size: 0.86rem; white-space: nowrap; border-radius: 6px; }
  .subnav a[aria-current="page"] { color: var(--ink); background: var(--surface); font-weight: 600; }
  .subnav a:hover { color: var(--ink); }
  /* On phones the three header rows would take ~130px of the screen for good; let them scroll away. */
  @media (max-width: 640px) {
    .site-header { position: static; }
    .bar { padding-top: 6px; }
    .tabs a { padding: 6px 9px 8px; }
  }
  .site-footer { border-top: 1px solid var(--border); padding: 20px 0 32px; color: var(--ink-2); }
</style>
