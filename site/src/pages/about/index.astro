---
import { link } from "../../lib/url";
import { AREAS } from "../../lib/area-data";
import { passed, validation } from "../../lib/validation";
import Base from "../../layouts/Base.astro";

// Read each area's check results: the site is only built when all of them pass.
const areas = AREAS.map((a) => {
  const v = validation(a.id);
  return { ...a, sources: `/${a.id}/sources/`, passed: passed(v), checks: v.checks };
});
const total = areas.reduce((s, a) => s + a.checks, 0);
---
<Base title="About" description="What India Data Review is, where its numbers come from and how they are checked.">
  <h1>About India Data Review</h1>
  <p>
    India Data Review presents official data on India's economy and public finances: what the government budgets
    and spends, how the economy grows, and how people work, earn and spend. Every number is read by a program from the government's own documents
    and data services, kept with a fingerprint of the file it came from, and checked before the site is built.
  </p>

  <section class="card">
    <h2>Principles</h2>
    <ul>
      <li><strong>Official sources only.</strong> Budget documents (indiabudget.gov.in), MoSPI's national accounts and surveys (labour force, consumer prices, household spending) and its press releases on pib.gov.in, the Labour Bureau's price indices for farm and rural labourers, the Economic Survey and the Reserve Bank of India. No news reports, no estimates of our own.</li>
      <li><strong>Every figure traceable.</strong> Each number links back to the document or data release it came from; the downloaded files are kept with their SHA-256 fingerprints.</li>
      <li><strong>Checked automatically.</strong> {total.toLocaleString("en-IN")} checks across all areas{areas.every((a) => a.passed) ? ", all passing" : ""}. The site cannot be built if any fails. Problems found in the official data are listed with a reason, not hidden.</li>
      <li><strong>Nothing changed.</strong> The site picks, adds up and divides published figures, and says so wherever it does. Estimates are labelled as estimates.</li>
    </ul>
  </section>

  <div class="grid-2 areas">
    {areas.map((a) => (
      <section class="card">
        <h2>{a.name}</h2>
        <p>{a.checks.toLocaleString("en-IN")} checks, {a.passed ? "all passing" : "with failures"}.</p>
        <p><a href={link(a.sources)}>Sources, checks and problems found</a></p>
        <p class="small"><a href={link(`/data/${a.id}/validation_report.md`)}>Validation report</a></p>
      </section>
    ))}
  </div>

  <section class="card">
    <h2>Not here yet</h2>
    <ul>
      <li>Population (Census 2011, projections, births and deaths), education and health.</li>
      <li>GDP revision history for 2000-01 to 2010-11, and IMF forecasts.</li>
    </ul>
  </section>

</Base>

<style>
  @media (min-width: 860px) { .areas { grid-template-columns: 1fr 1fr 1fr; } }
</style>
