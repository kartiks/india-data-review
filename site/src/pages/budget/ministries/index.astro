---
import Base from "../../../layouts/Base.astro";
import BarList from "../../../components/BarList.astro";
import { MINISTRIES, LATEST_YEAR, YEARS, ministryTotal, headline } from "../../../lib/budget/data";
import { money, signedPct } from "../../../lib/format";

const prev = YEARS[YEARS.length - 2];
const total = headline(LATEST_YEAR, "total_expenditure", "be")!.value;
const rows = MINISTRIES.map((m) => {
  const v = ministryTotal(LATEST_YEAR, m, "be");
  const p = ministryTotal(prev, m, "re");
  return { m, v, p };
}).filter((r) => r.v && r.v.value > 0).sort((a, b) => b.v!.value - a.v!.value);
---
<Base title="Ministries" section="ministries" description="Spending by every Union ministry, Budget 2000-01 to today.">
  <h1>Spending by ministry</h1>
  <p class="muted">
    Budget Estimates for {LATEST_YEAR}, with the change from {prev}'s revised figure. Ministry of Finance includes
    interest payments (₹{(headline(LATEST_YEAR, "interest_payments", "be")!.value / 100000).toFixed(2)} lakh crore) and grants to states.
  </p>
  <div class="controls">
    <label class="sr-only" for="q">Find a ministry</label>
    <input id="q" type="search" placeholder="Find a ministry…" autocomplete="off" data-filter="#ministry-list li" />
  </div>
  <section class="card" id="ministry-list">
    <BarList
      label="Ministries by spending"
      rows={rows.map(({ m, v, p }) => ({
        label: m.name.replace(/^Ministry of /, ""),
        value: v!.value,
        display: money(v!.value),
        sub: `${((v!.value / total) * 100).toFixed(1)}% of spending${p ? ` · ${signedPct(((v!.value - p.value) / p.value) * 100)} on ${prev} RE` : ""}`,
        href: `/budget/ministries/${m.id}/`,
      }))}
    />
  </section>
  <p class="note">
    Ministries are compared using their departments' lines in the Expenditure Budget. Before 2017-18 the budget was split
    into Plan and Non-plan and some departments were organised differently, so long-term comparisons for a single
    ministry can have breaks. Each ministry page notes them.
  </p>
  <script>
    import "../../../scripts/filter";
  </script>
</Base>
