---
import { link } from "../../../lib/url";
// Fallback for the year picker without JavaScript (form GET ?y=2010-11), plus a list of all years.
import Base from "../../../layouts/Base.astro";
import { YEARS, LATEST_YEAR } from "../../../lib/budget/data";
---
<Base title="All budget years" section="overview">
  <h1>All budget years</h1>
  <ul class="years">
    {[...YEARS].reverse().map((y) => <li><a href={link(y === LATEST_YEAR ? "/budget/" : `/budget/years/${y}/`)}>{y}</a></li>)}
  </ul>
  <script>
    const y = new URLSearchParams(location.search).get("y");
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    if (y && /^\d{4}-\d{2}$/.test(y)) location.replace(`${base}/years/${y}/`);
  </script>
</Base>
<style>
  .years { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
  .years a { display: block; padding: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; text-align: center; }
</style>
