---
import { link } from "../../../lib/url";
// Target of the year picker's form (GET ?y=2010-11). With JavaScript the picker navigates by itself
// and this page forwards any ?y= it receives; without it, the reader picks from the list below.
import Base from "../../../layouts/Base.astro";
import { YEARS, LATEST_YEAR } from "../../../lib/budget/data";
---
<Base title="All budget years" section="overview">
  <h1>All budget years</h1>
  <ul class="years" data-years={JSON.stringify(YEARS)} data-latest={LATEST_YEAR}>
    {[...YEARS].reverse().map((y) => <li><a href={link(y === LATEST_YEAR ? "/budget/" : `/budget/years/${y}/`)}>{y}</a></li>)}
  </ul>
  <script>
    import { link } from "../../../lib/url";
    const el = document.querySelector<HTMLElement>("[data-years]")!;
    const years: string[] = JSON.parse(el.dataset.years!);
    const y = new URLSearchParams(location.search).get("y");
    if (y && years.includes(y)) location.replace(link(y === el.dataset.latest ? "/budget/" : `/budget/years/${y}/`));
  </script>
</Base>
<style>
  .years { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
  .years a { display: block; padding: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; text-align: center; }
</style>
