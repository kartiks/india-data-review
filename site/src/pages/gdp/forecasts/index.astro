---
import Base from "../../../layouts/Base.astro";
import RangeRows from "../../../components/RangeRows.astro";
import PromiseGap from "../../../components/PromiseGap.astro";
import {
  OLD, NEW, STAGE_LABEL, SURVEY, BUDGET, rbiFor, rbiFirst, firstEstimate, latestStage, growthAt, node, range,
} from "../../../lib/gdp/data";
import { axisPct, gpct, money } from "../../../lib/format";

const lastYear = SURVEY[SURVEY.length - 1].fiscal_year;
const years = range("2011-12", lastYear);
const latestIn = (s: string, y: string) => {
  const st = latestStage(s, y, (n) => n.growth?.gdp?.real !== undefined);
  return st ? { v: growthAt(s, y, st)!.real!, st } : undefined;
};
const longDate = (d: string) => new Date(d + "T00:00:00Z").toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

const rows = [...years].reverse().map((y) => {
  const sv = SURVEY.find((s) => s.fiscal_year === y);
  const r1 = rbiFirst(y);
  const fe = firstEstimate(y);
  const lo = latestIn(OLD, y), ln = latestIn(NEW, y);
  const marks = [];
  if (sv) marks.push({ s: 0, lo: sv.low, hi: sv.high, text: sv.low === sv.high ? gpct(sv.low) : `${gpct(sv.low)} to ${gpct(sv.high)}` });
  if (r1) marks.push({ s: 1, v: r1.value!, text: `${gpct(r1.value!)}${r1.measure !== "GDP" ? ` (${r1.measure})` : ""}, ${longDate(r1.date)}` });
  if (fe && fe.series === OLD) marks.push({ s: 2, v: fe.real, text: `${gpct(fe.real)} (${STAGE_LABEL[fe.stage]})` });
  if (lo) marks.push({ s: 3, v: lo.v, text: `${gpct(lo.v)} (${STAGE_LABEL[lo.st]})` });
  if (ln) marks.push({ s: 4, v: ln.v, text: `${gpct(ln.v)} (${STAGE_LABEL[ln.st]})` });
  const notes = [];
  if (fyNum(y) <= 2014) notes.push("Forecasts made on the old 2004-05 base (GDP at factor cost); outcome on the 2011-12 base.");
  if (r1 && r1.measure !== "GDP") notes.push(`RBI projected ${r1.measure}, not GDP.`);
  if (sv?.band_low != null) notes.push(`Survey point forecast with a band of ${sv.band_low}–${sv.band_high}%.`);
  return { label: y, marks, note: notes.join(" ") };
});
function fyNum(y: string) { return Number(y.slice(0, 4)); }

// How often did the Survey's range contain the outcome (latest estimate, 2011-12 base, settled years)?
const judged = years.filter((y) => fyNum(y) >= 2015 && latestIn(OLD, y) && SURVEY.find((s) => s.fiscal_year === y)
  && (latestStage(OLD, y) ?? "") !== "AE1");
const score = judged.map((y) => {
  const sv = SURVEY.find((s) => s.fiscal_year === y)!, out = latestIn(OLD, y)!.v;
  const lo = sv.band_low ?? sv.low, hi = sv.band_high ?? sv.high;
  return { y, out, mid: (sv.low + sv.high) / 2, inside: out >= lo - 0.05 && out <= hi + 0.05, above: out > hi + 0.05 };
});
const inside = score.filter((s) => s.inside).length, above = score.filter((s) => s.above).length;
const rbiErr = judged.map((y) => Math.abs((rbiFirst(y)?.value ?? NaN) - (latestIn(OLD, y)?.v ?? NaN)));
const surveyErr = score.map((s) => Math.abs(s.mid - s.out));
// Median, so one extreme year (2020-21, COVID) does not dominate.
const median = (xs: number[]) => {
  const v = [...xs].sort((a, b) => a - b);
  return v.length % 2 ? v[(v.length - 1) / 2] : (v[v.length / 2 - 1] + v[v.length / 2]) / 2;
};

// RBI's path through each year.
const rbiYears = [...years].reverse().filter((y) => rbiFor(y).some((r) => r.value !== null));
const rbiRows = rbiYears.map((y) => {
  const all = rbiFor(y).filter((r) => r.value !== null);
  const first = all[0], last = all[all.length - 1];
  const fe = firstEstimate(y);
  const t = (r: typeof first) => `${gpct(r.value!)}${r.measure !== "GDP" ? ` ${r.measure}` : ""}, ${longDate(r.date)}`;
  const marks = [
    { s: 0, v: first.value!, text: t(first) },
    ...all.slice(1, -1).map((r) => ({ s: 1, v: r.value!, text: t(r) })),
    ...(all.length > 1 ? [{ s: 2, v: last.value!, text: t(last) }] : []),
  ];
  if (fe) marks.push({ s: 3, v: fe.real, text: `${gpct(fe.real)} (${STAGE_LABEL[fe.stage]}${fe.series === NEW ? ", new series" : ""})` });
  return { label: y, marks };
});

// Budget: assumed nominal GDP vs outcome in the same (2011-12) series. From Budget 2015-16, the first made on that series.
const gapRows = BUDGET.filter((b) => b.budget >= "2015-16").map((b) => {
  const st = latestStage(OLD, b.budget, (n) => n.gdp?.cur !== undefined);
  if (!st) return null;
  return { label: `Budget ${b.budget}`, be: b.gdp_crore, outcome: node(OLD, b.budget, st)!.gdp!.cur!, outcomeKind: STAGE_LABEL[st] };
}).filter((r): r is NonNullable<typeof r> => !!r).reverse();
const pending = BUDGET.filter((b) => !latestStage(OLD, b.budget, (n) => n.gdp?.cur !== undefined));
---
<Base title="Forecasts vs outcome" section="forecasts" description="What the Economic Survey, the RBI and the Union Budget expected India's GDP to do, against what happened.">
  <h1>Forecasts vs outcome</h1>
  <p class="muted">
    Each year the Economic Survey and the Reserve Bank of India forecast real GDP growth, and the Union Budget assumes a
    figure for nominal GDP. Every forecast here is quoted from the official document and checked against it.
  </p>

  <div class="tiles">
    <div class="tile">
      <div class="label">Survey range held the outcome</div>
      <div class="value">{inside} of {score.length}</div>
      <div class="sub">years {judged[0]} to {judged[judged.length - 1]}; above it {above}, below {score.length - inside - above}</div>
    </div>
    <div class="tile">
      <div class="label">Survey midpoint, typical miss</div>
      <div class="value">{median(surveyErr).toFixed(1)} pts</div>
      <div class="sub">median gap to the latest estimate</div>
    </div>
    <div class="tile">
      <div class="label">RBI start-of-year projection, typical miss</div>
      <div class="value">{median(rbiErr).toFixed(1)} pts</div>
      <div class="sub">median, same years</div>
    </div>
  </div>

  <section class="card">
    <RangeRows
      title="Real GDP growth: forecast and outcome"
      subtitle="Forecasts made before or at the start of each year, against MoSPI's first estimate and its latest."
      series={[
        { name: "Economic Survey", slot: 2, shape: "range" },
        { name: "RBI, start of year", slot: 3, shape: "diamond" },
        { name: "MoSPI first estimate", slot: 1, shape: "ring" },
        { name: "Latest, 2011-12 base", slot: 1, shape: "dot" },
        { name: "Latest, 2022-23 base", slot: 7, shape: "dot" },
      ]}
      rows={rows}
      format={axisPct}
      tableNotes={true}
      source="Economic Survey (indiabudget.gov.in), RBI monetary policy statements (rbi.org.in), MoSPI national accounts. Quotes and links are in the tables below."
    />
    <p class="small muted">
      The new 2022-23 series changed past growth a lot: it puts 2023-24 at {gpct(latestIn(NEW, "2023-24")!.v)}, against{" "}
      {gpct(latestIn(OLD, "2023-24")!.v)} in the old series. Forecasts made before February 2026 were for the old series.
    </p>
  </section>

  <section class="card">
    <RangeRows
      title="How the RBI's projection moved during each year"
      subtitle="Every projection the RBI published for the year, from its first to its last, against MoSPI's first estimate."
      series={[
        { name: "First projection", slot: 3, shape: "ring", join: true },
        { name: "Later projections", slot: 3, shape: "small", join: true },
        { name: "Last projection", slot: 3, shape: "dot", join: true },
        { name: "MoSPI first estimate", slot: 1, shape: "diamond" },
      ]}
      rows={rbiRows}
      format={axisPct}
      source="RBI monetary policy statements and MPC resolutions. 2015-16 to 2017-18: the RBI projected gross value added (GVA), not GDP. 2020-21: no number until October 2020."
    />
  </section>

  <section class="card">
    <h2>The Budget's GDP assumption</h2>
    <p class="muted">
      The Budget sets its figures as a share of a projected nominal GDP. Here is how that projection compared with
      MoSPI's latest figure for the year (2011-12 base). Blue: the economy turned out bigger than assumed.
    </p>
    <PromiseGap rows={gapRows.map((r) => ({ ...r, outcomeKind: r.outcomeKind }))} limit={20} />
    <p class="source">
      Budget at a Glance (indiabudget.gov.in), the note under its headline table. Budgets 2011-12 to 2014-15 assumed
      GDP on the old 2004-05 base, so they are listed below but not compared.
      {pending.length > 0 && <> No outcome yet for {pending.map((b) => `Budget ${b.budget}`).join(", ")}.</>}
    </p>
    <details class="table-view">
      <summary>Every Budget's assumption, as printed</summary>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Budget</th><th>Assumed GDP</th><th>Stated growth</th><th class="left">As printed</th></tr></thead>
          <tbody>
            {[...BUDGET].reverse().map((b) => (
              <tr>
                <td><a href={b.url} rel="external noopener">{b.budget}</a></td>
                <td>{money(b.gdp_crore)}</td>
                <td>{b.growth_pct != null ? `${b.growth_pct}%` : "–"}</td>
                <td class="wrap-text left">{b.text}{b.note ? ` (${b.note})` : ""}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="card">
    <h2>The forecasts, as published</h2>
    <details class="table-view">
      <summary>Economic Survey: projection for the coming year</summary>
      <div class="table-scroll">
        <table>
          <thead><tr><th>For</th><th>Forecast</th><th class="left">Survey</th><th class="left">Quote</th></tr></thead>
          <tbody>
            {[...SURVEY].reverse().map((s) => (
              <tr>
                <td>{s.fiscal_year}</td>
                <td>{s.low === s.high ? gpct(s.low) : `${gpct(s.low)} to ${gpct(s.high)}`}</td>
                <td class="left">{s.survey}, {longDate(s.published_date)}</td>
                <td class="wrap-text left">“{s.quote}” <a href={s.url} rel="external noopener">PDF{s.pdf_page ? `, p. ${s.pdf_page}` : ""}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
    <details class="table-view">
      <summary>RBI: every projection</summary>
      <div class="table-scroll">
        <table>
          <thead><tr><th>For</th><th>Date</th><th>Projection</th><th class="left">Quote</th></tr></thead>
          <tbody>
            {[...years].reverse().flatMap((y) => rbiFor(y).map((r) => (
              <tr>
                <td>{r.fiscal_year}</td>
                <td>{longDate(r.date)}</td>
                <td>{r.value !== null ? `${gpct(r.value)}${r.measure !== "GDP" ? ` ${r.measure}` : ""}` : r.value_text ?? "no number"}</td>
                <td class="wrap-text left">“{r.quote}” <a href={r.url} rel="external noopener">RBI</a></td>
              </tr>
            )))}
          </tbody>
        </table>
      </div>
    </details>
  </section>
</Base>

<style>
  th.left, td.left { text-align: left; }
  .card details + details { margin-top: 6px; }
</style>
