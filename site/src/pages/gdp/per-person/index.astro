---
import { link } from "../../../lib/url";
import Base from "../../../layouts/Base.astro";
import LineChart from "../../../components/LineChart.astro";
import {
  NEW, OLD, LATEST_YEAR, STAGE_LABEL, SERIES_LABEL, POPULATION, PP_YEAR, node, growthAt, yearsOf, range, prevYear,
  bestOf, latestStage, popOf, perPersonGrowth, type Node, type PerPersonMeasure,
} from "../../../lib/gdp/data";
import { axisPct, gpct, rupees, rupeesAxis } from "../../../lib/format";

// Headline: the latest year of the new 2022-23 series that has a population. Each January MoSPI adds a year whose
// population is added by hand later (see gdp/README.md); until then the page stays on the year before.
const Y = PP_YEAR!;
const ST = latestStage(NEW, Y)!;
const pp = node(NEW, Y, ST)!.per_person!;
const gdpGrowth = growthAt(NEW, Y, ST)?.real;
const ppGrowth = perPersonGrowth(NEW, Y);
const popRate = (series: string, y: string) => {
  const a = popOf(series, prevYear(y)), b = popOf(series, y);
  return a && b ? (b.million / a.million - 1) * 100 : undefined;
};
const popGrowth = popRate(NEW, Y);
const pending = LATEST_YEAR !== Y ? LATEST_YEAR : undefined;
// Are the headline figures checked against MoSPI's own? Not when none of the per-person figures quoted here for the
// year is for MoSPI's latest totals (the figures then divide the latest totals by the population MoSPI used).
const newChecked = Boolean(POPULATION.checked[NEW]?.[Y]);
const span = (ys: string[]) => (ys.length > 1 ? `${ys[0]} to ${ys[ys.length - 1]}` : ys.join(""));
const newCheckedYears = Object.keys(POPULATION.checked[NEW] ?? {}).sort();
const oldCheckedYears = Object.keys(POPULATION.checked[OLD] ?? {}).sort();
const yPopDoc = popOf(NEW, Y)?.document;

const kind = (series: string, y: string) => { const st = latestStage(series, y); return st ? STAGE_LABEL[st] : ""; };
const oldYears = yearsOf(OLD).filter((y) => popOf(OLD, y));
const newYears = yearsOf(NEW).filter((y) => popOf(NEW, y));
const lastYear = [...oldYears, ...newYears].sort().at(-1)!;

// Real growth of GDP per person, each series on its own.
const gYears = range(oldYears[1], lastYear);
const growthPoints = (series: string, have: string[]) => gYears.map((y) => {
  const v = have.includes(y) && have.includes(prevYear(y)) ? perPersonGrowth(series, y) : undefined;
  return { value: v ?? null, kind: v === undefined ? "" : kind(series, y) };
});

// Income per person at current prices: levels, each series drawn separately.
const lYears = range(oldYears[0], lastYear);
const levelPoints = (series: string) =>
  bestOf(series, lYears, (n) => n.per_person?.nni?.cur).map((p) => ({ value: p?.value ?? null, kind: p ? STAGE_LABEL[p.stage] : "" }));

// Table: every year of each series, latest estimate.
const pick = (n: Node | undefined, m: PerPersonMeasure, price: "cur" | "con" = "cur") => n?.per_person?.[m]?.[price];
const tableRows = [
  ...[...newYears].reverse().map((y) => ({ series: NEW, y })),
  ...[...oldYears].reverse().map((y) => ({ series: OLD, y })),
].map(({ series, y }) => {
  const st = latestStage(series, y)!;
  const n = node(series, y, st);
  return {
    series, y, stage: STAGE_LABEL[st], pop: popOf(series, y)!.million,
    gdp: pick(n, "gdp"), nni: pick(n, "nni"), pfce: pick(n, "pfce"), growth: perPersonGrowth(series, y),
  };
});
const f = (v: number | undefined, fmt: (v: number) => string) => (v === undefined ? "–" : fmt(v));
const million = (v: number) => new Intl.NumberFormat("en-IN", { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v);
const SRC = POPULATION.sources;
const until = POPULATION.projections_until;
const SOURCE = "MoSPI national accounts (latest estimate of each year) divided by population at the middle of the year: the 2019 official projections to 2021-22, then MoSPI's own figures.";
---
<Base title="Per person" section="per-person" description="India's GDP, national income and household spending per person, and their growth after inflation, from MoSPI's national accounts.">
  <h1>GDP and income per person</h1>
  <p class="lede">
    In {Y}, India's GDP came to <strong>{rupees(pp.gdp!.cur!)}</strong> a person, and national income to{" "}
    <strong>{rupees(pp.nni!.cur!)}</strong> a person ({STAGE_LABEL[ST].toLowerCase()}, new 2022-23 series,
    current prices).
    {ppGrowth !== undefined && gdpGrowth !== undefined && popGrowth !== undefined && (
      <> After inflation, GDP per person grew <strong>{gpct(ppGrowth)}</strong>, against {gpct(gdpGrowth)} for GDP as a
      whole: the population grew about {gpct(popGrowth)}.</>
    )}
  </p>
  {(pending || !newChecked) && (
    <p class="muted small status">
      {pending && <>MoSPI's {STAGE_LABEL[latestStage(NEW, pending)!].toLowerCase()} for {pending} is out, but its population has not been added here yet, so per-person figures stop at {Y}. </>}
      {!newChecked && <>None of MoSPI's per-person figures for {Y} quoted here is for its latest totals, so the {Y} figures divide those totals by the population MoSPI used{yPopDoc ? ` (${yPopDoc.replace(/^Press note/, "press note")})` : ""} and are not checked against MoSPI's own. {newCheckedYears.length > 0 && `The new series' figures for ${span(newCheckedYears)} reproduce MoSPI's. `}{oldCheckedYears.length > 0 && `So do the 2011-12 series' figures for ${span(oldCheckedYears)}.`}</>}
    </p>
  )}

  <div class="tiles">
    <div class="tile">
      <div class="label">GDP per person, {Y}</div>
      <div class="value">{rupees(pp.gdp!.cur!)}</div>
      <div class="sub">current prices</div>
    </div>
    <div class="tile">
      <div class="label">Income per person, {Y}</div>
      <div class="value">{rupees(pp.nni!.cur!)}</div>
      <div class="sub">net national income, current prices</div>
    </div>
    <div class="tile">
      <div class="label">Household spending per person, {Y}</div>
      <div class="value">{rupees(pp.pfce!.cur!)}</div>
      <div class="sub">a year, current prices</div>
    </div>
    <div class="tile">
      <div class="label">Real growth per person, {Y}</div>
      <div class="value">{f(ppGrowth, gpct)}</div>
      <div class="sub">GDP per person after inflation</div>
    </div>
  </div>

  <section class="card">
    <LineChart
      title="Real growth of GDP per person"
      subtitle={`GDP per person at constant prices, on the year before. It runs below GDP growth by about the rate the population grows${popRate(OLD, gYears[0]) !== undefined && popGrowth !== undefined ? `: ${gpct(popRate(OLD, gYears[0])!)} in ${gYears[0]}, ${gpct(popGrowth)} in ${Y}` : ""}.`}
      years={gYears}
      series={[
        { name: SERIES_LABEL[OLD], slot: 1, points: growthPoints(OLD, oldYears) },
        { name: SERIES_LABEL[NEW], slot: 2, points: growthPoints(NEW, newYears) },
      ]}
      format={axisPct}
      tableFormat={(v) => gpct(v)}
      annotations={[{ year: "2020-21", label: "COVID-19" }]}
      source={SOURCE}
    />
  </section>

  <section class="card">
    <LineChart
      title="Income per person at current prices"
      subtitle="Net national income per person, in each year's rupees. The two series are drawn separately: the new base measures the economy differently."
      years={lYears}
      series={[
        { name: SERIES_LABEL[OLD], slot: 1, points: levelPoints(OLD) },
        { name: SERIES_LABEL[NEW], slot: 2, points: levelPoints(NEW) },
      ]}
      format={rupeesAxis}
      tableFormat={rupees}
      source={SOURCE}
    />
  </section>

  <section class="card">
    <h2>Every year</h2>
    <p class="muted small">Latest estimate in each series, current prices; real growth at constant prices.</p>
    <div class="table-scroll">
      <table class="pp">
        <thead>
          <tr>
            <th>Year</th><th>Series</th><th>Estimate</th><th>Population (million)</th><th>GDP per person</th>
            <th>Income per person</th><th>Household spending per person</th><th>Real growth of GDP per person</th>
          </tr>
        </thead>
        <tbody>
          {tableRows.map((r) => (
            <tr>
              <td>{r.y}</td><td>{SERIES_LABEL[r.series]}</td><td>{r.stage}</td><td>{million(r.pop)}</td>
              <td>{f(r.gdp, rupees)}</td><td>{f(r.nni, rupees)}</td><td>{f(r.pfce, rupees)}</td><td>{f(r.growth, gpct)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="small muted notes">
      <li><strong>GDP per person</strong> is gross domestic product divided by the population. <strong>Income per person</strong> is net national income (gross national income, which is GDP plus net income from abroad, less depreciation) divided by the population: what MoSPI calls per capita income. India's net income from abroad is negative, so national income is below GDP. <strong>Household spending</strong> is private final consumption expenditure.</li>
      <li><strong>Population</strong> is India's population at the middle of each financial year (1 October), as MoSPI uses it. To {until} it is the official projection (<a href={SRC.projections.url} rel="external noopener">{SRC.projections.title}</a>, {SRC.projections.table}); MoSPI's figures equal it in the years they could be checked ({Object.keys(POPULATION.checked[OLD] ?? {}).filter((y) => y <= until).join(" and ") || "none"}). From the next year MoSPI uses its own figures, slightly above the projections; they are taken from its National Accounts Statistics ({SRC.nas.map((n, i) => <>{i > 0 && "; "}<a href={n.url} rel="external noopener">{n.document}</a></>)}) and press notes ({SRC.press_notes.map((n, i) => <>{i > 0 && "; "}<a href={n.url} rel="external noopener">{n.document}</a></>)}) and, where no press note here covers the year, from the RBI's reprint of MoSPI's tables ({SRC.rbi.map((t, i) => <>{i > 0 && "; "}<a href={t.url} rel="external noopener">{t.title}</a></>)}). The two series use slightly different populations for the same year, as MoSPI does.</li>
      <li><strong>The change of population source</strong> between {until} and the next year is in MoSPI's own figures too. It makes the population grow faster that year in the 2011-12 series ({f(popRate(OLD, range(until, lastYear)[1]), (v) => gpct(v, 2))}, against 0.91% from one projection to the next), so growth per person that year is a little lower than it would be on a single population source.</li>
      <li><strong>Worked out here</strong>: each figure is MoSPI's latest total divided by that population, and growth per person is worked out from the constant-price figures. Where the total is the one MoSPI printed its per-person figure from, the two agree to the rupee (checked). Where MoSPI has revised the total since the press note quoted here, the figure here uses the revised total with that note's population, and differs a little from the one printed in the note. Per-person figures are for the latest estimate of each year only: MoSPI divided earlier estimates by the population known at the time.</li>
      <li>Constant prices are those of each series' base year (2011-12 or 2022-23), so real levels from the two series are not compared; growth rates are. See <a href={link("/gdp/sources/")}>Sources and checks</a>.</li>
    </ul>
  </section>
</Base>

<style>
  .lede { font-size: 1.08rem; max-width: 46em; }
  .pp td:not(:nth-child(-n+3)), .pp th:not(:nth-child(-n+3)) { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .notes { margin-top: 12px; padding-left: 18px; }
  .status { max-width: 46em; margin-top: -4px; }
</style>
