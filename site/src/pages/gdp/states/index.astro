---
import Base from "../../../layouts/Base.astro";
import StateMap, { type MapMetric } from "../../../components/StateMap.astro";
import BarList from "../../../components/BarList.astro";
import LineChart from "../../../components/LineChart.astro";
import { link } from "../../../lib/url";
import { stateKey } from "../../../lib/jobs-prices/data";
import {
  STATES, STATE_YEARS, FIRST_YEAR, SECTORS, SECTOR_LABEL, LATEST, NOT_COVERED, BOUNDARY, sNode, countWith, gsdpCur,
  realGrowth, incomePerPerson, gsdpPerPerson, sectorShares, averageGrowth, isDerived, india, indiaAverageGrowth,
} from "../../../lib/gdp/states";
import { axisPct, gpct, money, pct } from "../../../lib/format";

// One year for every measure, so states are compared like with like: the latest year in which the states that have
// published made up at least 97% of the states' economy the year before.
const Y = LATEST;
const NEXT = STATE_YEARS[STATE_YEARS.indexOf(Y) + 1];
const nextCount = NEXT ? countWith(NEXT, gsdpCur) : 0;
const rupees = (v: number) => `₹${new Intl.NumberFormat("en-IN", { maximumFractionDigits: 0 }).format(v)}`;
const f = (v: number | null | undefined, fmt: (v: number) => string) => (v == null ? "–" : fmt(v));
const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);

const rows = STATES.map((st) => {
  const n = sNode(st, Y);
  return {
    st,
    key: stateKey(st),
    gsdp: n ? gsdpCur(n) ?? null : null,
    derived: isDerived(st, Y),
    growth: n ? realGrowth(n) ?? null : null,
    growthWorkedOut: n?.growth?.gsdp?.published === false,
    avg: averageGrowth(st, FIRST_YEAR, Y) ?? null,
    boundary: BOUNDARY[st] && BOUNDARY[st].until >= FIRST_YEAR && BOUNDARY[st].until < Y,
    income: n ? incomePerPerson(n) ?? null : null,
    gsdpPP: n ? gsdpPerPerson(n) ?? null : null,
    shares: sectorShares(n),
  };
});
const all = rows.filter((r) => r.gsdp != null);
const total = all.reduce((a, r) => a + r.gsdp!, 0);
const IN = india(Y);
const inAvg = indiaAverageGrowth(FIRST_YEAR, Y);
const derived = rows.filter((r) => r.derived).map((r) => r.st);
const missing = rows.filter((r) => r.gsdp == null).map((r) => r.st);

const metric = (id: string, label: string, title: string, fmt: (v: number) => string, note: string, get: (r: (typeof rows)[number]) => number | null | undefined): MapMetric => ({
  id, label, title, note, format: fmt, values: Object.fromEntries(rows.map((r) => [r.key, get(r) ?? null])),
});
const metrics: MapMetric[] = [
  metric("size", "Size", `Size of the state economy (GSDP), ${Y}`, (v) => money(v),
    `Gross state domestic product at current prices.${IN ? ` India's GDP: ${money(IN.gdp)}.` : ""}`, (r) => r.gsdp),
  metric("growth", "Growth", `Real growth, ${Y}`, (v) => gpct(v),
    `GSDP at constant 2011-12 prices, on the year before.${IN?.growth != null ? ` India: ${gpct(IN.growth)}.` : ""}`, (r) => r.growth),
  metric("avg", `Growth since ${FIRST_YEAR}`, `Average real growth a year, ${FIRST_YEAR} to ${Y}`, (v) => gpct(v),
    `Worked out from constant-price GSDP in the two years.${inAvg != null ? ` India: ${gpct(inAvg)}.` : ""}`, (r) => r.avg),
  metric("income", "Income per person", `Income per person, ${Y}`, rupees,
    "Net state domestic product per person, current prices.", (r) => r.income),
  ...SECTORS.map((s) => metric(s, SECTOR_LABEL[s], `${SECTOR_LABEL[s]}, share of the state's value added, ${Y}`, (v) => pct(v),
    `Current prices.${IN?.shares ? ` India: ${pct(IN.shares[s])}.` : ""}`, (r) => r.shares?.[s])),
];
const names = Object.fromEntries(rows.map((r) => [r.key, r.st]));

const biggest = [...all].sort((a, b) => b.gsdp! - a.gsdp!);
const richest = rows.filter((r) => r.income != null).sort((a, b) => b.income! - a.income!);
const sizeRows = biggest.slice(0, 12).map((r) => ({
  label: r.st, value: r.gsdp!, display: money(r.gsdp!), sub: `${pct((Number(r.gsdp) / total) * 100)} of all states`,
}));
const incomeRows = richest.map((r, i) => ({ label: `${i + 1}. ${r.st}`, value: r.income!, display: rupees(r.income!) }))
  .filter((_, i) => i < 6 || i >= richest.length - 6);
const top = richest[0], bottom = richest[richest.length - 1];
const gap = (Number(top.income) / Number(bottom.income)).toFixed(1);
const sumShare = IN ? pct((total / IN.gdp) * 100) : undefined;
const boundaryNotes = rows.filter((r) => r.boundary).map((r) => BOUNDARY[r.st].note);

// Growth over time, six largest economies.
const gyears = STATE_YEARS.filter((y) => y > FIRST_YEAR && y <= Y);
const six = biggest.slice(0, 6);
const growthSeries = six.map((r, i) => ({
  name: r.st, slot: i + 1,
  points: gyears.map((y) => { const n = sNode(r.st, y); return { value: n ? realGrowth(n) ?? null : null }; }),
}));
const SOURCE = "MoSPI, state accounts (gross state domestic product), 2011-12 base, via api.mospi.gov.in.";
---
<Base title="States" section="states" description="Each Indian state's economy: size, growth, income per person and the shares of agriculture, industry and services, from MoSPI's state accounts.">
  <h1>States</h1>
  <p class="lede">
    The size, growth and make-up of each state's economy, from MoSPI's state accounts: gross state domestic product
    (GSDP), the state counterpart of GDP. Figures are for {Y}, the latest year nearly all states have published, on the
    2011-12 base{nextCount ? `; ${nextCount} states have published ${NEXT} so far` : ""}.
  </p>

  <section class="card">
    <StateMap
      metrics={metrics}
      names={names}
      source={`${SOURCE} State boundaries: DataMeet India community (CC BY 4.0), following the Survey of India's map, simplified for display; for the authoritative map, see the Survey of India.`}
    />
  </section>

  <div class="grid-2">
    <section class="card">
      <h2>The largest economies, {Y}</h2>
      <p class="small muted">GSDP at current prices, and its share of all {all.length} states and union territories together.</p>
      <BarList
        label={`States by GSDP, ${Y}`}
        rows={sizeRows}
      />
      {missing.length > 0 && <p class="small muted">Not yet published for {Y}: {list(missing)}.</p>}
    </section>
    <section class="card">
      <h2>Income per person, {Y}</h2>
      <p class="small muted">Net state domestic product per person, current prices. The six highest and six lowest, by rank.</p>
      <BarList
        label={`States by income per person, ${Y}`}
        tone={2}
        rows={incomeRows}
      />
      <p class="small muted">{top.st}'s income per person is {gap} times {bottom.st}'s. All {richest.length} are in the table below.</p>
    </section>
  </div>

  <section class="card">
    <LineChart
      title="Real growth of the six largest state economies"
      subtitle={`GSDP at constant 2011-12 prices, on the year before, ${gyears[0]} to ${Y}`}
      years={gyears}
      series={growthSeries}
      format={axisPct}
      tableFormat={(v) => gpct(v)}
      zero
      source={SOURCE}
    />
  </section>

  <section class="card">
    <details class="table-details">
      <summary>Show all states as a table</summary>
      <div class="table-scroll">
        <table class="states">
          <thead>
            <tr>
              <th>State / UT</th>
              <th>GSDP, {Y}</th>
              <th>Real growth, {Y}</th>
              <th>Average growth, {FIRST_YEAR} to {Y}</th>
              <th>Income per person</th>
              <th>GSDP per person</th>
              {SECTORS.map((s) => <th>{SECTOR_LABEL[s]}</th>)}
            </tr>
          </thead>
          <tbody>
            {IN && (
              <tr class="india">
                <td>All India</td><td>{money(IN.gdp)}</td><td>{f(IN.growth, gpct)}</td><td>{f(inAvg, gpct)}</td><td>–</td><td>–</td>
                {SECTORS.map((s) => <td>{f(IN.shares?.[s], pct)}</td>)}
              </tr>
            )}
            {rows.map((r) => (
              <tr>
                <td>{r.st}</td>
                <td>{f(r.gsdp, money)}{r.derived && <sup title="Worked out as GSVA + taxes − subsidies">†</sup>}</td>
                <td>{f(r.growth, gpct)}{r.growthWorkedOut && <sup title="Worked out from the levels">†</sup>}</td>
                <td>{f(r.avg, gpct)}{r.boundary && <sup title="Area changed during the period">‡</sup>}</td>
                <td>{f(r.income, rupees)}</td>
                <td>{f(r.gsdpPP, rupees)}</td>
                {SECTORS.map((s) => <td>{f(r.shares?.[s], pct)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
    <ul class="small muted notes">
      <li><strong>GSDP</strong>: gross state domestic product, current prices. <strong>Real growth</strong>: at constant 2011-12 prices, as MoSPI publishes it. <strong>Average growth</strong>: the yearly rate that takes constant-price GSDP from {FIRST_YEAR} to {Y}.</li>
      <li><strong>Income per person</strong>: net state domestic product (GSDP less depreciation) per person, current prices. <strong>GSDP per person</strong> is the gross figure.</li>
      <li><strong>Agriculture, industry and services</strong>: shares of the state's gross value added at current prices. Industry is mining, manufacturing, utilities and construction.</li>
      {derived.length > 0 && <li>† MoSPI's GSDP table does not include {list(derived)}. Their GSDP is worked out as gross value added plus taxes on products minus subsidies, MoSPI's own definition (for every other state the two agree, to within rounding), and their growth from those levels.</li>}
      {boundaryNotes.map((n) => <li>‡ {n}</li>)}
      {IN && <li><strong>All India</strong>: national accounts on the same 2011-12 base ({IN.stageLabel}). The states do not add up exactly to India's GDP: together they come to {sumShare} of it in {Y}. State figures are compiled by each state's statistics office and released at different times; national figures are compiled separately by MoSPI.</li>}
      <li>A dash, or grey on the map, means MoSPI publishes no figure for {Y}{missing.length ? ` (${list(missing)})` : ""}. {NOT_COVERED.length > 0 && `Not in MoSPI's state accounts: ${NOT_COVERED.join("; ")}.`}</li>
      <li>Every figure is checked before the site is built: GSDP adds up from industries, taxes and subsidies; growth follows from the levels; the per-person figures agree. See <a href={link("/gdp/sources/")}>Sources and checks</a>.</li>
    </ul>
  </section>
</Base>

<style>
  .lede { font-size: 1.08rem; max-width: 46em; }
  .table-details summary { cursor: pointer; font-weight: 600; }
  .table-details .table-scroll { margin-top: 12px; }
  .states td:not(:first-child), .states th:not(:first-child) { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .states tr.india td { font-weight: 600; }
  .states sup { color: var(--muted); margin-left: 2px; }
  .notes { margin-top: 12px; padding-left: 18px; }
</style>
