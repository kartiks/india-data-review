---
import { link } from "../lib/url";
import Base from "../layouts/Base.astro";
import LineChart from "../components/LineChart.astro";
import Money from "../components/Money.astro";
import {
  LONG, NEW, OLD, LATEST_YEAR, LATEST_STAGE, STAGE_LABEL, node, growthAt, quarters, quarterNode, BUDGET,
  firstEstimate, latestGrowth, yearsOf, range,
} from "../lib/data";
import { axisPct, gpct, money } from "../lib/format";

const latest = node(NEW, LATEST_YEAR, LATEST_STAGE)!;
const g = growthAt(NEW, LATEST_YEAR, LATEST_STAGE)!;
const qs = quarters(NEW).filter((p) => quarterNode(NEW, p)?.growth?.gdp?.real !== undefined);
const lastQ = qs[qs.length - 1];
const qg = quarterNode(NEW, lastQ)!.growth!.gdp!;
const budget = BUDGET[BUDGET.length - 1];
const budgetSub = budget.growth_pct ? `nominal, ${budget.growth_pct}% growth` : "nominal";
// How much lower the new series puts GDP than the old one, for the year both cover in full (2022-23).
const overlap = "2022-23";
const newGdp = node(NEW, overlap)?.gdp?.cur ?? NaN;
const oldGdp = node(OLD, overlap)?.gdp?.cur ?? NaN;
const gap = (1 - newGdp / oldGdp) * 100;

// Biggest revision among recent years: first estimate vs latest.
interface Rev { y: string; first: number; last: number; d: number }
const revs: Rev[] = [];
for (const y of range("2014-15", "2024-25")) {
  const f = firstEstimate(y), l = latestGrowth(y);
  if (f && l) revs.push({ y, first: f.real, last: l.real, d: l.real - f.real });
}
const big = revs.reduce((a, b) => (Math.abs(b.d) > Math.abs(a.d) ? b : a));

const years = LONG.filter((r) => r.growth?.real !== undefined).map((r) => r.year);
const newYears = yearsOf(NEW);
const oldPoints = years.map((y) => {
  const r = LONG.find((x) => x.year === y)!;
  return { value: r.growth!.real!, kind: r.stage === "BACK" ? "Back series" : STAGE_LABEL[r.stage] };
});
const newPoints = years.map((y) => {
  if (!newYears.includes(y)) return { value: null };
  const gg = latestGrowth(y, NEW);
  return gg && gg.series === NEW ? { value: gg.real, kind: STAGE_LABEL[gg.stage] } : { value: null };
});
---
<Base title="India GDP Review" section="overview">
  <h1>India's GDP, from the official numbers</h1>
  <p class="lede">
    India's economy grew <strong>{gpct(g.real!)}</strong> after inflation in {LATEST_YEAR}, according to the{" "}
    {STAGE_LABEL[LATEST_STAGE].toLowerCase()} from the Ministry of Statistics (MoSPI), on its new 2022-23 base. In today's rupees, GDP was{" "}
    <strong>{money(latest.gdp!.cur!)}</strong>.
  </p>

  <div class="tiles">
    <div class="tile">
      <div class="label">Real GDP growth, {LATEST_YEAR}</div>
      <div class="value">{gpct(g.real!)}</div>
      <div class="sub">{STAGE_LABEL[LATEST_STAGE]}; nominal {gpct(g.nominal!)}</div>
    </div>
    <div class="tile">
      <div class="label">GDP, {LATEST_YEAR}</div>
      <div class="value"><Money value={latest.gdp!.cur!} /></div>
      <div class="sub">at current prices</div>
    </div>
    <div class="tile">
      <div class="label">Latest quarter, {lastQ}</div>
      <div class="value">{gpct(qg.real!)}</div>
      <div class="sub">real growth on a year earlier</div>
    </div>
    <div class="tile">
      <div class="label">Budget {budget.budget} assumes GDP of</div>
      <div class="value"><Money value={budget.gdp_crore} /></div>
      <div class="sub">{budgetSub}</div>
    </div>
  </div>

  <section class="card">
    <LineChart
      title="Real GDP growth since 1951-52"
      subtitle="Growth after inflation, each year on the year before. The new 2022-23 series starts in 2023-24."
      years={years}
      series={[
        { name: "2011-12 base (incl. MoSPI back series)", slot: 1, points: oldPoints },
        { name: "2022-23 base (new series)", slot: 2, points: newPoints },
      ]}
      format={axisPct}
      tableFormat={(v) => gpct(v)}
      annotations={[
        { year: "1979-80", label: "Drought" },
        { year: "1991-92", label: "1991 crisis" },
        { year: "2008-09", label: "Global crisis" },
        { year: "2020-21", label: "COVID-19" },
      ]}
      source="MoSPI national accounts. 1951-52 to 2011-12: MoSPI's back series on the 2011-12 base (growth worked out from its GDP levels). From 2012-13: growth as published, latest estimate."
    />
  </section>

  <section class="card note-card">
    <h2>Two GDP series</h2>
    <p>
      MoSPI rebased India's GDP to 2022-23 on 27 February 2026, with new data sources and methods. The new series
      starts in {overlap} and puts that year's GDP {gap.toFixed(1)}% lower than the old 2011-12-base series did, so levels
      from the two series are never mixed on this site. Growth rates from both are shown, each labelled. MoSPI is
      expected to publish a back series on the new base later.
    </p>
  </section>

  <div class="grid-2">
    <div class="card link-card">
      <h2><a href={link("/revisions/")}>Revisions</a></h2>
      <p class="muted">Growth is estimated up to six times. {big.y} was first put at {gpct(big.first)}; it is now {gpct(big.last)}.</p>
    </div>
    <div class="card link-card">
      <h2><a href={link("/forecasts/")}>Forecasts vs outcome</a></h2>
      <p class="muted">What the Economic Survey, the RBI and the Budget expected, against what happened.</p>
    </div>
    <div class="card link-card">
      <h2><a href={link("/sectors/")}>Sectors</a></h2>
      <p class="muted">Agriculture, industry and services: their share of the economy and how fast each grows.</p>
    </div>
    <div class="card link-card">
      <h2><a href={link("/spending/")}>Spending, investment, saving</a></h2>
      <p class="muted">Household and government spending, investment by who invests, and the saving rate.</p>
    </div>
    <div class="card link-card">
      <h2><a href={link("/quarters/")}>Quarters</a></h2>
      <p class="muted">Quarter-by-quarter growth, the most recent signal of where the economy is going.</p>
    </div>
    <div class="card link-card">
      <h2><a href={link("/about/")}>Sources and checks</a></h2>
      <p class="muted">Where every number comes from, how it is checked, and problems found in the official data.</p>
    </div>
  </div>
</Base>

<style>
  .lede { font-size: 1.08rem; max-width: 46em; }
  .link-card { position: relative; }
  .link-card h2 a { text-decoration: none; }
  .link-card h2 a::after { content: ""; position: absolute; inset: 0; }
  .link-card:hover { border-color: var(--accent); }
  .link-card p { margin: 0; }
  .grid-2 { margin-bottom: 16px; }
  @media (min-width: 860px) { .grid-2 { grid-template-columns: 1fr 1fr 1fr; } }
</style>
