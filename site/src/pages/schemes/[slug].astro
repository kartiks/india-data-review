---
import Money from "../../components/Money.astro";
import Base from "../../layouts/Base.astro";
import LineChart from "../../components/LineChart.astro";
import {
  SCHEMES, SCHEME_YEARS, SCHEME_TYPE_LABEL, SCHEME_NAMES, schemeValue, announcedVsOutcome, ministryOfScheme,
  KINDS, KIND_LABEL, type Scheme,
} from "../../lib/data";
const SCHEME_YEARS_FIRST_BUDGET = "2017-18";
import { money, moneyShort, exact, signedPct } from "../../lib/format";

export function getStaticPaths() {
  return SCHEMES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Scheme };
const series = announcedVsOutcome(SCHEME_YEARS, (y, k) => schemeValue(y, s.key, k)?.value);
const ministry = ministryOfScheme(s);
const latest = SCHEME_YEARS[SCHEME_YEARS.length - 1];
const latestBE = schemeValue(latest, s.key, "be");
const lastActualYear = [...SCHEME_YEARS].reverse().find((y) => schemeValue(y, s.key, "actual"));
const lastActual = lastActualYear ? schemeValue(lastActualYear, s.key, "actual") : undefined;
const lastActualBE = lastActualYear ? schemeValue(lastActualYear, s.key, "be") : undefined;
const names = SCHEME_NAMES.get(s.key) ?? [];
const distinctNames = [...new Set(names.map((n) => n.name))];
const notes = new Set<string>();
const rows = SCHEME_YEARS.map((y) => {
  const vals = KINDS.map((k) => schemeValue(y, s.key, k));
  vals.forEach((v) => v?.source.note && notes.add(v.source.note));
  return { y, vals };
}).filter((r) => r.vals.some(Boolean));
const docName = s.type === "css" ? "Statement 4A" : "Statement 4B";
const firstBudget = names[0]?.budget;
const listedLate = firstBudget && firstBudget > SCHEME_YEARS_FIRST_BUDGET;
---
<Base title={s.name} section="schemes" description={`${s.name}: budget allocations and spending since 2017-18, from India's Expenditure Profile.`}>
  <p class="small"><a href="/schemes/">← All schemes</a></p>
  <h1>{s.name}</h1>
  <p class="muted">
    <span class="chip">{SCHEME_TYPE_LABEL[s.type]}</span>
    {ministry ? <a href={`/ministries/${ministry.id}/`}>{ministry.name}</a> : s.department}
  </p>

  <div class="tiles">
    {latestBE && (
      <div class="tile"><div class="label">Budget {latest}</div><div class="value"><Money value={latestBE.value} /></div></div>
    )}
    {lastActual && (
      <div class="tile"><div class="label">Actually spent, {lastActualYear}</div><div class="value"><Money value={lastActual.value} /></div>
        {lastActualBE && <div class="sub">{signedPct(((lastActual.value - lastActualBE.value) / lastActualBE.value) * 100)} vs budget of {money(lastActualBE.value)}</div>}
      </div>
    )}
  </div>

  {listedLate && (
    <p class="note">
      First listed as a separate scheme in Budget {firstBudget}. Before that, its money may have been reported as part
      of a larger umbrella scheme or under another name, so earlier years are not shown here.
    </p>
  )}
  {[...notes].map((n) => <p class="note">{n}</p>)}

  <section class="card">
    <LineChart
      title="Allocation and spending"
      subtitle="Outcome (actual, or revised where actuals aren't out yet) and the amount announced in each budget."
      years={SCHEME_YEARS}
      series={[
        { name: "Outcome", slot: 1, points: series.outcome },
        { name: "Announced in the budget", slot: 2, points: series.announced },
      ]}
      format={moneyShort}
      tableFormat={exact}
      tipFormat={money}
      source={`Expenditure Profile ${docName}, Budgets 2017-18 to ${latest}.`}
    />
  </section>

  <section class="card">
    <h2>Every figure</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Year</th>{KINDS.map((k) => <th>{KIND_LABEL[k]}</th>)}</tr></thead>
        <tbody>
          {rows.map(({ y, vals }) => (
            <tr><td>{y}</td>{vals.map((v) => <td>{v ? (v.source.url ? <a href={v.source.url} rel="external noopener" title={`Printed in Budget ${v.source.budget}`}>{exact(v.value)}</a> : exact(v.value)) : "–"}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="source">Each figure links to the official PDF it was read from. Budget Estimates come from that year's budget, Revised Estimates from the next, Actuals from the one after.</p>
  </section>

  {distinctNames.length > 1 && (
    <section class="card">
      <h2>Names over the years</h2>
      <ul class="small">
        {names.map((n) => <li>Budget {n.budget}: {n.name}</li>)}
      </ul>
      <p class="source">Renamed schemes are linked when the same figure is printed under both names in consecutive budgets.</p>
    </section>
  )}
</Base>
