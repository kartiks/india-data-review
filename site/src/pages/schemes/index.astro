---
import Base from "../../layouts/Base.astro";
import BarList from "../../components/BarList.astro";
import { SCHEMES, SCHEME_YEARS, schemeValue, ministryOfScheme } from "../../lib/data";
import { money } from "../../lib/format";

const latest = SCHEME_YEARS[SCHEME_YEARS.length - 1];
const top = SCHEMES.map((s) => ({ s, v: schemeValue(latest, s.key, "be") }))
  .filter((x) => x.v && x.v.value > 0)
  .sort((a, b) => b.v!.value - a.v!.value)
  .slice(0, 30);
---
<Base title="Schemes" section="schemes" description="Every Centrally Sponsored and Central Sector scheme in India's Union Budget since 2017-18.">
  <h1>Schemes</h1>
  <p class="muted">
    Every Centrally Sponsored Scheme (run with the states) and Central Sector Scheme (run by the Centre) since Budget
    2017-18. Earlier budgets only show schemes as "Plan" outlays, which aren't comparable.
  </p>
  <div class="controls">
    <label class="sr-only" for="q">Search schemes</label>
    <input id="q" type="search" placeholder={`Search ${SCHEMES.length.toLocaleString("en-IN")} schemes, e.g. Jal Jeevan…`} autocomplete="off" />
    <label class="sr-only" for="type">Scheme type</label>
    <select id="type">
      <option value="">All types</option>
      <option value="1">Centrally Sponsored</option>
      <option value="0">Central Sector</option>
    </select>
  </div>
  <section class="card" id="results" hidden>
    <h2 id="results-title">Results</h2>
    <ol class="results" id="results-list"></ol>
  </section>
  <section class="card" id="top">
    <h2>Largest schemes, Budget {latest}</h2>
    <BarList label="Largest schemes" rows={top.map(({ s, v }) => ({
      label: s.name, value: v!.value, display: money(v!.value), href: `/schemes/${s.slug}/`,
      note: ministryOfScheme(s)?.name ?? s.department,
    }))} />
  </section>
  <script>
    import { money } from "../../lib/format";
    type Row = [string, string, number, string, number | null, string];
    const q = document.querySelector<HTMLInputElement>("#q")!;
    const type = document.querySelector<HTMLSelectElement>("#type")!;
    const box = document.querySelector<HTMLElement>("#results")!;
    const list = document.querySelector<HTMLOListElement>("#results-list")!;
    const title = document.querySelector<HTMLElement>("#results-title")!;
    const top = document.querySelector<HTMLElement>("#top")!;
    let index: { year: string; rows: Row[] } | null = null;
    async function run() {
      const text = q.value.trim().toLowerCase();
      if (!text && !type.value) { box.hidden = true; top.hidden = false; return; }
      index ??= await (await fetch("/schemes-index.json")).json();
      const words = text.split(/\s+/).filter(Boolean);
      const hits = index!.rows
        .filter((r) => (type.value === "" || String(r[2]) === type.value) && words.every((w) => `${r[1]} ${r[3]} ${r[5]}`.toLowerCase().includes(w)))
        .sort((a, b) => (b[4] ?? -1) - (a[4] ?? -1));
      title.textContent = `${hits.length} scheme${hits.length === 1 ? "" : "s"}`;
      list.replaceChildren(...hits.slice(0, 100).map((r) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `/schemes/${r[0]}/`;
        a.textContent = r[1];
        const meta = document.createElement("span");
        meta.className = "meta";
        meta.textContent = `${r[3]}${r[4] != null ? ` · ${money(r[4])} (${index!.year})` : " · no allocation in " + index!.year}`;
        li.append(a, meta);
        return li;
      }));
      box.hidden = false;
      top.hidden = true;
    }
    q.addEventListener("input", run);
    type.addEventListener("change", run);
  </script>
</Base>
<style>
  .controls input { flex: 1 1 260px; }
  .results { list-style: none; padding: 0; margin: 0; }
  .results :global(li) { padding: 8px 0; border-bottom: 1px solid var(--grid); }
  .results :global(.meta) { display: block; font-size: 0.82rem; color: var(--ink-2); }
</style>
