---
import Base from "../../layouts/Base.astro";
import LineChart from "../../components/LineChart.astro";
import StackedColumns from "../../components/StackedColumns.astro";
import { YEARS, LATEST_YEAR, KIND_LABEL, tax, taxMix, statesShare, bestSeries, type Kind } from "../../lib/data";
import { money, moneyShort, exact, pct } from "../../lib/format";

// Best available figure per year, from ONE budget document per year (so parts add up to the total).
const yearKinds = YEARS.map((y) => (["actual", "re", "be"] as Kind[]).find((k) => taxMix(y, k)) ?? null);
const mixes = YEARS.map((y, i) => (yearKinds[i] ? taxMix(y, yearKinds[i]!) : undefined));
const categories = [
  { id: "income_tax", label: "Income tax", slot: 1 },
  { id: "corporation_tax", label: "Corporation tax", slot: 2 },
  { id: "gst", label: "GST", slot: 3 },
  { id: "union_excise", label: "Excise", slot: 4 },
  { id: "customs", label: "Customs", slot: 5 },
  { id: "service_tax", label: "Service tax", slot: 6 },
  { id: "other", label: "Other taxes", slot: 7 },
];
const values = mixes.map((m) => categories.map((c) => m?.parts.find((p) => p.id === c.id)?.value ?? null));
const kindLabel = { actual: "Actual", re: "RE", be: "BE" } as const;

const t = (id: string) => (y: string, k: Kind) => tax(y, id, k)?.value;
const sharePct = (y: string, k: Kind) => {
  const s = statesShare(y, k), g = tax(y, "gross_tax_revenue", k);
  return s && g && s.source.budget === g.source.budget ? (s.value / g.value) * 100 : undefined;
};

// Latest budget: full breakdown as printed.
const latestKind: Kind = "be";
const rows = [
  ["gross_tax_revenue", "Gross tax revenue"],
  ["corporation_tax", "Corporation tax"],
  ["income_tax", "Taxes on income (other than corporation tax)"],
  ["gst", "Goods and Services Tax (GST)"],
  ["cgst", "of which Central GST"],
  ["gst_compensation_cess", "of which GST compensation cess"],
  ["customs", "Customs"],
  ["union_excise", "Union excise duties"],
  ["service_tax", "Service tax"],
  ["ut_taxes", "Taxes of Union Territories"],
  ["other_taxes", "Other taxes"],
  ["nccd_transferred", "Less: transferred to disaster response funds (NCCD)"],
  ["states_share", "Less: states' share"],
  ["net_tax_revenue", "Centre's net tax revenue"],
] as const;
const latest = rows.map(([id, label]) => ({ id, label, v: tax(LATEST_YEAR, id, latestKind) })).filter((r) => r.v);
---
<Base title="Taxes" section="taxes" description="India's central taxes since 2000-01: income tax, corporation tax, GST, customs, excise, and the states' share.">
  <h1>Taxes</h1>
  <p class="muted">
    Gross taxes collected by the Centre, by type. Part of every tax is handed to the states; what remains is the
    Centre's net tax revenue.
  </p>

  <section class="card">
    <StackedColumns
      title="Gross tax revenue by type"
      subtitle="Actual figures; the last years are revised or budget estimates (marked in the table and hover)."
      years={YEARS}
      categories={categories}
      values={values}
      kinds={yearKinds.map((k) => (k ? kindLabel[k] : ""))}
      format={moneyShort}
      tipFormat={money}
      source="Budget at a Glance, Receipts; actuals 2000-01 to 2007-08 from Receipt Budget Annex 7. GST began in July 2017 and replaced service tax and most excise duties."
    />
  </section>

  <section class="card">
    <LineChart
      title="Income tax overtook corporation tax"
      years={YEARS}
      series={[
        { name: "Income tax", slot: 1, points: bestSeries(YEARS, t("income_tax")) },
        { name: "Corporation tax", slot: 2, points: bestSeries(YEARS, t("corporation_tax")) },
      ]}
      format={moneyShort}
      tableFormat={money}
      annotations={[{ year: "2019-20", label: "Corporate tax cut" }]}
      source="Budget at a Glance, Receipts (gross collections)."
    />
  </section>

  <section class="card">
    <LineChart
      title="States' share of central taxes"
      subtitle="Share of gross tax revenue passed to the states, as set by each Finance Commission."
      years={YEARS}
      series={[{ name: "States' share", slot: 1, points: bestSeries(YEARS, sharePct) }]}
      format={(v) => pct(v, 0)}
      tableFormat={(v) => pct(v)}
      zero={false}
      annotations={[{ year: "2015-16", label: "14th Finance Commission" }]}
      source="States' share ÷ gross tax revenue, Budget at a Glance, Receipts. Includes the prior-year adjustment where printed."
    />
  </section>

  <section class="card">
    <h2>Budget {LATEST_YEAR} in detail</h2>
    <p class="muted small">{KIND_LABEL[latestKind]}s as printed in Budget {LATEST_YEAR}.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Item</th><th>Amount</th></tr></thead>
        <tbody>
          {latest.map((r) => (
            <tr class={r.id === "gross_tax_revenue" || r.id === "net_tax_revenue" ? "strong" : r.label.startsWith("of which") ? "sub" : ""}>
              <td class="wrap-text">{r.label}</td><td>{exact(r.v!.value)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="source">
      Source: Budget at a Glance, Receipts, Budget {LATEST_YEAR}.{" "}
      {latest[0]?.v?.source.url && <a href={latest[0].v.source.url} rel="external noopener">Official PDF</a>}
    </p>
  </section>
</Base>
<style>
  tr.strong td { font-weight: 600; }
  tr.sub td:first-child { padding-left: 20px; color: var(--ink-2); }
</style>
