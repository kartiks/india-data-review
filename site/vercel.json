{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/budget/years/",
      "has": [
        {
          "type": "query",
          "key": "y",
          "value": "(?<year>\\d{4}-\\d{2})"
        }
      ],
      "destination": "/budget/years/:year/",
      "permanent": false
    }
  ]
}
